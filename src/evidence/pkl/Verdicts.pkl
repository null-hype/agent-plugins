/// Verdict functions: the actual comparison semantics for registered
/// expectations. Given an observed world (Jev probabilities keyed by case
/// identity), each function returns a typed `Verdict` -- a stable code plus a
/// diagnostic message. Python never re-interprets these semantics; it supplies
/// the observed world and compares codes in a thin matcher (see
/// `contract_suite.py`), the same shape as `expect(fact).toHaveVerdict(...)`
/// in tutorial-app: a named check produces a uniform verdict, a thin matcher
/// compares it, and every evaluation is recorded.
module evidence.Verdicts

/// Observed Jev probabilities: case (observation) id -> question id -> value.
typealias Probabilities = Mapping<String, Mapping<String, Number>>

class Verdict {
  code: String
  message: String
}

function probability(results: Probabilities, obs: String, question: String): Number? =
  results.getOrNull(obs)?.getOrNull(question)

local function missing(obs: String, question: String): Verdict = new {
  code = "MISSING_OBSERVATION"
  message = "no observed probability for case \"\(obs)\" on question \"\(question)\""
}

/// `higher` must strictly exceed `lower`.
function orderVerdict(results: Probabilities, question: String, higher: String, lower: String): Verdict =
  let (hi = probability(results, higher, question))
  let (lo = probability(results, lower, question))
    if (hi == null) missing(higher, question)
    else if (lo == null) missing(lower, question)
    else if (hi > lo) new { code = "EXPECTED_ORDER"; message = "\(higher) (\(hi)) > \(lower) (\(lo))" }
    else if (hi == lo) new { code = "ORDER_TIED"; message = "\(higher) and \(lower) are both \(hi)" }
    else new { code = "ORDER_REVERSED"; message = "\(higher) (\(hi)) is below \(lower) (\(lo))" }

/// A numeric band. An uncalibrated band is not asserted on real results: it
/// yields an explicit NOT_ASSERTED_UNCALIBRATED status, never a silent pass.
function bandVerdict(results: Probabilities, question: String, obs: String, min: Number, max: Number,
    calibrated: Boolean, real: Boolean): Verdict =
  let (p = probability(results, obs, question))
    if (real && !calibrated) new { code = "NOT_ASSERTED_UNCALIBRATED"; message = "band [\(min), \(max)] on \(obs) is uncalibrated; not asserted on a real result" }
    else if (p == null) missing(obs, question)
    else if (p >= min && p <= max) new { code = "WITHIN_BAND"; message = "\(obs) \(p) in [\(min), \(max)]" }
    else new { code = "OUTSIDE_BAND"; message = "\(obs) \(p) outside [\(min), \(max)]" }

/// A probability must be a finite number in [0, 1].
function validityVerdict(results: Probabilities, obs: String, question: String): Verdict =
  let (p = probability(results, obs, question))
    if (p == null) missing(obs, question)
    else if (p.isFinite && p >= 0 && p <= 1) new { code = "VALID_PROBABILITY"; message = "\(obs) \(p)" }
    else new { code = "INVALID_PROBABILITY"; message = "\(obs) \(p) is not a finite probability in [0, 1]" }
