/// Contract for a method scenario: canned observations, fixed Jev questions
/// and pre-registered expectations, all declared as data. A scenario module
/// `amends` this. Case data lives in the scenario, never here.
///
/// The three views are kept apart on purpose and read separately by the
/// Python adapter (`pkl eval -x <property>`):
///
///   agent/Jev side  : groundingFiles, observations, ungrounded, malformed,
///                     questions, mockAnswers, hintLevel
///   evaluator only  : expectations
///
/// `expectations` is never written to a file the reasoning agent or Jev can
/// see, and `questions` are fixed templates: nothing in them is derived from
/// an observation or an expectation (checked by `invariants`).
///
/// Mock answers are stimulus for the mock backend. Assertions over them prove
/// wiring, not Jev's discrimination or calibration.
open module evidence.Scenario

import "pkl:json"
import "Evidence.pkl"
import "Verdicts.pkl"

/// A Noul question, in the shape the `jev` client accepts.
class Question {
  type: "noul"
  instructions: String(!isEmpty)
  criteria: Mapping<String, String>?
}

/// `higher` must receive a strictly higher probability than `lower` on
/// `question` (both are observation ids). Relative assertions need no
/// calibration and are where a scenario starts.
class Relative {
  question: String
  higher: String
  lower: String
  /// The verdict code this check is registered to produce.
  expected: String = "EXPECTED_ORDER"
  /// A required check whose observation is missing FAILS (MISSING_OBSERVATION
  /// is not an accepted code); an optional one may be missing.
  required: Boolean = true
}

/// A numeric confidence band. Only set `calibrated = true` after calibration on
/// independently established known-answer cases, frozen before held-out
/// evaluation. An uncalibrated band is asserted against MOCK answers only, as
/// a wiring check; on a real result it yields the explicit recorded status
/// NOT_ASSERTED_UNCALIBRATED, never a silent pass.
class Band {
  calibrated: Boolean = false
  question: String
  observation: String
  min: Number(isBetween(0, 1))
  max: Number(isBetween(0, 1))
  expected: String = "WITHIN_BAND"
  required: Boolean = true
}

/// Pre-registered before any evaluated live run. Probability validity
/// (VALID_PROBABILITY for every observed case x question) is always checked
/// and needs no entry.
class Expectations {
  relative: Listing<Relative>
  bands: Listing<Band>
}

/// What was observed in one repeat. `results` keys are DECLARED case
/// identities (observation ids). `worldRef` is a stable reference to the
/// preserved inputs/results this world was built from.
class World {
  run: String
  repeat: Int
  real: Boolean
  worldRef: String
  results: Verdicts.Probabilities
}

/// One evaluated check: uniform record written for every check, pass or fail.
class Evaluation {
  run: String
  repeat: Int
  caseId: String
  checkId: String
  axiom: String
  question: String
  worldRef: String
  actual: String
  expected: String
  /// Codes the matcher accepts as a pass.
  accepted: Listing<String>
  /// False only for an explicitly not-asserted check (e.g. uncalibrated band
  /// on a real result). Such a check is recorded and reported, never verified.
  asserted: Boolean
  message: String
}

/// A canned world with the verdict code each check must produce in it, used to
/// check the verdict functions on known inputs (out-of-band, reversed,
/// missing, uncalibrated).
class Diagnostic {
  world: World
  /// checkId -> expected verdict code
  expect: Mapping<String, String>
}

/// Files (path relative to the image root -> content) the adapter writes
/// into a temp root, for self-contained grounding. Leave empty when the root
/// is baked into the image and named by `rootDir`.
groundingFiles: Mapping<String, String> = new {}

/// Absolute path of a root baked into the scenario image (instead of
/// `groundingFiles`).
rootDir: String?

/// Canned grounded observations (stand-in for agent-collected evidence).
observations: Mapping<String, Evidence.EvidenceFile>

/// Valid-shape evidence that is deliberately NOT grounded.
ungrounded: Mapping<String, Evidence.EvidenceFile> = new {}

/// Raw JSON text that is deliberately not valid evidence.
malformed: Mapping<String, String> = new {}

/// Fixed question templates.
questions: Mapping<String, Question>

/// Canned Jev answers per observation id, for the mock backend only.
mockAnswers: Mapping<String, Mapping<String, Number(isBetween(0, 1))>>

/// Runtime parameter passed to a reasoning agent in the full experiment.
hintLevel: Int = 0

/// The declared case identity (an observation id) that agent-collected
/// evidence from this scenario's root is scored as. Without it the generic
/// "agent" id matches no registered check, and every required check fails as
/// MISSING_OBSERVATION.
agentObservationId: String?

/// Evaluator-only. Never sent to the agent or Jev.
expectations: Expectations

/// Known-input worlds for the verdict functions.
diagnostics: Mapping<String, Diagnostic> = new {}

local function ev(w: World, axiomId: String, case_: String, check_: String, qid: String,
    v: Verdicts.Verdict, expectedCode: String, isRequired: Boolean): Evaluation = new {
  run = w.run
  repeat = w.repeat
  caseId = case_
  checkId = check_
  axiom = axiomId
  question = qid
  worldRef = w.worldRef
  actual = v.code
  expected = expectedCode
  accepted = if (isRequired) new Listing { expectedCode } else new Listing { expectedCode; "MISSING_OBSERVATION" }
  asserted = v.code != "NOT_ASSERTED_UNCALIBRATED"
  message = v.message
}

/// Evaluate every registered check, plus probability validity for every
/// observed case x question, in one observed world.
function evaluate(w: World): Listing<Evaluation> = new Listing {
  for (id in w.results.keys.toList().sort()) {
    for (qid in questionIds.toList().sort()) {
      ev(w, "expectation.validity", id, "validity:\(id):\(qid)", qid,
        Verdicts.validityVerdict(w.results, id, qid), "VALID_PROBABILITY", true)
    }
  }
  for (r in expectations.relative) {
    ev(w, "expectation.relative", r.higher, "relative:\(r.question):\(r.higher)>\(r.lower)", r.question,
      Verdicts.orderVerdict(w.results, r.question, r.higher, r.lower), r.expected, r.required)
  }
  for (b in expectations.bands) {
    ev(w, "expectation.band", b.observation, "band:\(b.question):\(b.observation)", b.question,
      Verdicts.bandVerdict(w.results, b.question, b.observation, b.min, b.max, b.calibrated, w.real), b.expected, b.required)
  }
}

/// The observed world for this run, supplied by the adapter as JSON
/// (`-p world.uri=file:///...`). Empty when none is supplied.
local worldUri: String? = read?("prop:world.uri")

evaluations: Listing<Evaluation> =
  if (worldUri == null) new Listing {}
  else
    let (raw = new json.Parser { useMapping = true }.parse(read(worldUri).text) as Mapping)
      evaluate(new World {
        run = raw["run"]
        repeat = raw["repeat"]
        real = raw["real"]
        worldRef = raw["worldRef"]
        results = raw["results"]
      })

/// Evaluations of each diagnostic world, keyed like `diagnostics`.
diagnosticEvaluations: Mapping<String, Listing<Evaluation>> = new {
  for (name, d in diagnostics) {
    [name] = evaluate(d.world)
  }
}

function isGrounded(f: Evidence.Finding): Boolean =
  (groundingFiles.getOrNull(f.source_path)?.contains(f.excerpt)) ?? false

local allFindings: List<Evidence.Finding> =
  observations.toMap().values.flatMap((o) -> o.findings.toList())

local knownCodes: Set<String> = Set("VALID_PROBABILITY", "INVALID_PROBABILITY", "EXPECTED_ORDER", "ORDER_REVERSED",
  "ORDER_TIED", "WITHIN_BAND", "OUTSIDE_BAND", "MISSING_OBSERVATION", "NOT_ASSERTED_UNCALIBRATED")

local questionIds: Set<String> = questions.keys

/// Invariants for a `pkl:test` module: `facts = scenario.invariants()`.
function invariants(): Mapping<String, Listing<Boolean>> = new Mapping<String, Listing<Boolean>> {
  ["canned observations are grounded in groundingFiles"] {
    when (rootDir == null) {
      for (_, o in observations) {
        for (f in o.findings) { isGrounded(f) }
      }
    }
  }
  ["ungrounded observations contain a finding that is not grounded"] {
    when (rootDir == null) {
      for (_, o in ungrounded) {
        o.findings.toList().any((f) -> !isGrounded(f))
      }
    }
  }
  ["mock answers cover exactly the observations and exactly the question ids"] {
    mockAnswers.keys == observations.keys
    for (_, a in mockAnswers) { a.keys == questionIds }
  }
  ["non-empty observations carry distinguishable evidence"] {
    let (excerpts = allFindings.map((f) -> f.excerpt))
      excerpts.toSet().length == excerpts.length
  }
  ["expectations reference known observations and questions"] {
    for (r in expectations.relative) {
      questionIds.contains(r.question)
      observations.containsKey(r.higher)
      observations.containsKey(r.lower)
      r.higher != r.lower
    }
    for (b in expectations.bands) {
      questionIds.contains(b.question)
      observations.containsKey(b.observation)
      b.min <= b.max
    }
  }
  ["every diagnostic expectation names a check that evaluation produces, with a known code"] {
    for (name, d in diagnostics) {
      for (check_, code in d.expect) {
        evaluate(d.world).toList().any((e) -> e.checkId == check_)
        knownCodes.contains(code)
      }
    }
  }
  ["diagnostic worlds produce exactly their expected verdicts"] {
    for (name, d in diagnostics) {
      for (check_, code in d.expect) {
        evaluate(d.world).toList().filter((e) -> e.checkId == check_).every((e) -> e.actual == code)
      }
    }
  }
  ["agent evidence is scored as a declared case identity"] {
    agentObservationId == null || observations.containsKey(agentObservationId!!)
  }
  ["question templates are fixed: no observation text or id leaks into them"] {
    for (_, q in questions) {
      for (f in allFindings) {
        !q.instructions.contains(f.excerpt)
        !q.instructions.contains(f.never)
      }
      for (id, _ in observations) { !q.instructions.contains(id) }
    }
  }
}
