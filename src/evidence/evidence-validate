#!/usr/bin/env python3
"""Validate an evidence file, and optionally ground its excerpts in an image root.

usage: evidence-validate [--root DIR] FILE

Exit 0: valid (and grounded, if --root). Exit 1: invalid or ungrounded, with
one line per problem on stderr. Exit 2: usage or unreadable input.
The format is defined by evidence.schema.json next to this script's install
location; this file enforces the same rules with the standard library only.
"""
import json
import os
import sys

FIELDS = {"component": str, "source_path": str, "excerpt": str, "never": str, "enforced": bool}


def schema_errors(doc):
    if not isinstance(doc, dict):
        return ["top level must be an object"]
    errs = [f"unexpected top-level key {k!r}" for k in doc if k != "findings"]
    findings = doc.get("findings")
    if not isinstance(findings, list):
        return errs + ["'findings' must be an array"]
    for i, f in enumerate(findings):
        at = f"findings[{i}]"
        if not isinstance(f, dict):
            errs.append(f"{at} must be an object")
            continue
        errs += [f"{at}: unexpected key {k!r}" for k in f if k not in FIELDS]
        for k, t in FIELDS.items():
            if k not in f:
                errs.append(f"{at}: missing {k!r}")
            elif not isinstance(f[k], t):
                errs.append(f"{at}: {k!r} must be {t.__name__}")
            elif t is str and not f[k]:
                errs.append(f"{at}: {k!r} must not be empty")
    return errs


def grounding_errors(doc, root):
    errs = []
    real_root = os.path.realpath(root)
    for i, f in enumerate(doc["findings"]):
        at = f"findings[{i}]"
        path = os.path.realpath(os.path.join(real_root, f["source_path"].lstrip("/")))
        if os.path.commonpath([real_root, path]) != real_root:
            errs.append(f"{at}: source_path {f['source_path']!r} escapes the image root")
        elif not os.path.isfile(path):
            errs.append(f"{at}: no such file {f['source_path']!r} in the image")
        else:
            with open(path, encoding="utf-8", errors="replace") as fh:
                if f["excerpt"] not in fh.read():
                    errs.append(f"{at}: excerpt not found verbatim in {f['source_path']!r}")
    return errs


def main(argv):
    root = None
    if argv[:1] == ["--root"] and len(argv) >= 2:
        root, argv = argv[1], argv[2:]
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        with open(argv[0], encoding="utf-8") as fh:
            doc = json.load(fh)
    except (OSError, ValueError) as e:
        print(f"cannot read {argv[0]}: {e}", file=sys.stderr)
        return 1
    errs = schema_errors(doc)
    if not errs and root is not None:
        errs = grounding_errors(doc, root)
    for e in errs:
        print(e, file=sys.stderr)
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
