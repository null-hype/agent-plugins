#!/usr/bin/env python3
"""Validate an evidence file, and optionally ground its excerpts in an image root.

usage: evidence-validate [--root DIR] FILE

Exit 0: valid (and grounded, if --root). Exit 1: invalid or ungrounded, with
the problems on stderr. Exit 2: usage.
The format is defined by Evidence.pkl and loaded through pkl-python bindings.
This script adds filesystem grounding.
"""
import os
import sys

_here = os.path.dirname(os.path.abspath(__file__))
for _p in (os.environ.get("EVIDENCE_LIB"), "/usr/local/share/evidence/lib", os.path.join(_here, "lib")):
    if _p and os.path.isdir(_p):
        sys.path.insert(0, _p)
        break

import evidence_contract  # noqa: E402


def main(argv):
    root = None
    if argv[:1] == ["--root"] and len(argv) >= 2:
        root, argv = argv[1], argv[2:]
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    errs, _ = evidence_contract.validate(argv[0], root)
    for e in errs:
        print(e, file=sys.stderr)
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
