/// CIT-334: the shared evaluation record, on synthetic states. Nothing here is
/// about Rails or a PR; tutorial-app/tests/rails-probes/traces/ReplayRecord.test.pkl
/// checks the generated records of a real investigation.
///
///   pkl test src/jev/pkl/EvaluationRecord.test.pkl
amends "pkl:test"

import "Question.pkl"
import "Jev.pkl"

local kept = new Question.Evidence {
  uri = "inputs.json"
  origin = "historical"
  availability = "retained"
  immutableId = "sha256:abc"
}
local rerun = (kept) { uri = "answer.json"; origin = "reproduced"; immutableId = "sha256:def" }
local gap = new Question.Evidence {
  uri = "original-output"
  origin = "historical"
  availability = "missing"
  reason = "Not retained"
}
local q = new Question.Question {
  judge = new Question.Checker {}
  collector = "remove-input"
  requiredEvidence { "exitCode" }
  expected { min = 1; max = 1 }
}
local base = new Question.EvaluationRecord {
  questionId = "remove-input"
  question = q
  state { id = "r1"; source = (kept) { uri = "repo"; immutableId = "git-commit:1" }; scope { "checker inputs" }; inputs { kept } }
  mutation { action = "Remove input"; affects { "inputs.json" }; evidence { rerun } }
  delivery {
    feature = "example"
    status = "planned"
    finding = "finding-1"
    scenario = "example-scenario"
  }
  declarations {
    new { text = "28 asserts"; evidence = kept; property = "assertsTotal"; declared = 28; observed = 28; observedFrom = rerun }
  }
  answer = new Question.CheckerAnswer { exitCode = 0; assertsPassed = 28; assertsTotal = 28 }
  observations { rerun; gap }
}
local second = (base) {
  state { id = "r2"; source { immutableId = "git-commit:2" } }
}
local investigation = new Question.Investigation {
  questionId = "remove-input"
  records { base; second }
  transitions { new { from = "r1"; to = "r2"; action = "Revise after finding-1"; finding = "finding-1"; evidence { kept } } }
}

facts {
  ["Shared assessment preserves unexpected answers"] {
    Question.validRecord(base)
    base.outcome == "out-of-range"
    !Question.failsRun(base.outcome)
  }
  ["Missing evidence has a reason and no fabricated immutable identity"] {
    Question.validEvidence(gap)
    !Question.validEvidence((gap) { reason = null })
    !Question.validEvidence((gap) { immutableId = "invented" })
    !Question.validEvidence((kept) { immutableId = null })
  }
  ["A probe stays inside its state: it can only affect the state's own inputs"] {
    !Question.validRecord((base) { mutation { affects { "not-an-input" } } })
    Question.validRecord((base) { mutation = null })
  }
  ["A transition links consecutive states and changes the source"] {
    Question.validInvestigation(investigation)
    !Question.validInvestigation((investigation) { transitions { [0] { to = "r1" } } })
    !Question.validInvestigation((investigation) { records { [1] { state { source { immutableId = "git-commit:1" } } } } })
    !Question.validInvestigation((investigation) { transitions = new Listing {} })
  }
  ["Every record in an investigation asks the same Question"] {
    !Question.validInvestigation((investigation) { records { [1] { questionId = "other" } } })
    !Question.validInvestigation((investigation) { records { [1] { question { expected { min = 0 } } } } })
  }
  ["A planned version cannot imply a delivered capture"] {
    Question.validRecord((base) { delivery { version = "20261008.0811" } })
    !Question.validRecord((base) { delivery { status = "captured" } })
    !Question.validRecord((base) { delivery { status = "captured"; evidence = kept } })
    Question.validRecord((base) { delivery { status = "captured"; version = "20261008.0811"; evidence = kept } })
    !Question.validRecord((base) { delivery { evidence = kept } })
  }
  ["Two review rounds are two versions"] {
    !Question.validInvestigation((investigation) {
      records { [0] { delivery { version = "20261008.0811" } }; [1] { delivery { version = "20261008.0811" } } }
    })
  }
  ["A declared value is observed from a reproduction, and may disagree"] {
    Question.validRecord((base) { declarations { [0] { observed = 27 } } })
    !Question.validRecord((base) { declarations { [0] { observedFrom = kept } } })
    !Question.validRecord((base) { declarations { [0] { observedFrom = null } } })
    !Question.validRecord((base) { declarations { [0] { property = null } } })
  }
  ["Missing answers remain not collected"] {
    (base) { answer = null }.outcome == "not-collected"
    !Question.validRecord((base) { observations = new Listing { gap } })
  }
  ["Forecasts remain distinct from answers and policy expectations"] {
    (base) { forecast = 0.4 }.outcome == "out-of-range"
    !Question.validRecord((base) { answer = 0.4 })
    Question.validRecord((base) {
      question { judge = new Jev.NoulQuestion { instructions = "Does it hold?" } }
      answer = 0.4
      forecast = 0.8
    })
  }
}
