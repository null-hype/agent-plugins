/// CIT-315: the Question primitive, shared by every pipeline that asks one.
///
/// A Question is a piece of domain knowledge put as something to find out. A
/// collector gathers the evidence; whoever the Question names in `judge`
/// answers it:
///
/// - a Jev Noul judge (`Jev.NoulQuestion`), whose answer is a probability, or
/// - the deterministic checker (`Checker`), whose answer is what the checker did
///   to the collected evidence (`CheckerAnswer`): it noticed, or it did not.
///
/// `expected` is the range a sound answer falls in, on a 0 to 1 scale. An answer
/// outside it is data, recorded like any other. Only an answer that could not be
/// collected fails a run (`failsRun`).
///
/// Used by `jev-playwright/pkl/Experiment.pkl` (Jev answers) and
/// `tutorial-app/tests/rails-probes/traces/CheckerProbes.pkl` (the checker answers).
module Question

import "Jev.pkl"

typealias Id = String(matches(Regex("[a-z][a-z0-9-]{0,79}")))

class Expectation {
  min: Number(isFinite, isBetween(0, 1))
  max: Number(isFinite, isBetween(min, 1))
}

/// The deterministic checker as the answerer. It is not asked anything in
/// words: its answer is what it did when run against the collected evidence.
class Checker {
  type: "checker" = "checker"
}

open class Question {
  /// Questions whose answers this one's collector reads.
  dependencies: Listing<Id> = new Listing {}
  /// Who answers. A Jev judge unless the Question says otherwise.
  judge: *Jev.NoulQuestion|Checker
  /// The name of the code that gathers the evidence.
  collector: String(!isEmpty)
  requiredEvidence: Listing<String(!isEmpty)>(!isEmpty)
  expected: Expectation
  /// The lesson this Question's answer becomes, if it is told in one (CIT-318).
  lesson: Lesson?
}

/// A lesson's place in its chapter and its text (CIT-316). This is the only copy
/// of the text: the tutorial reporter writes it out, and nothing else holds it.
class Lesson {
  /// Its place in the chapter, counting from 1.
  order: Int(isPositive)
  /// Also the lesson's directory name, slugified.
  title: String(!isEmpty)
  /// Markdown. It may tell the run's answer, so it renders only once there is one.
  prose: String(!isEmpty)
}

/// What the runner recorded for one checker run. Read from the run, never declared.
class CheckerAnswer {
  exitCode: Int
  testsPassed: Int?
  testsTotal: Int?
  assertsPassed: Int?
  assertsTotal: Int?
}

/// The checker noticed: it failed, or not every assertion passed.
function noticed(a: CheckerAnswer): Boolean = a.exitCode != 0 || a.assertsPassed != a.assertsTotal

/// An answer on the scale `expected` is written on: a Jev probability as is,
/// a checker answer as 1 when it noticed and 0 when it did not.
function value(answer: Number|CheckerAnswer): Number =
  if (answer is CheckerAnswer) (if (noticed(answer)) 1 else 0) else answer as Number

function inRange(expected: Expectation, value: Number): Boolean =
  value >= expected.min && value <= expected.max

/// Where an answer stands. A missing answer (`null`) could not be collected.
typealias Outcome = "in-range"|"out-of-range"|"not-collected"

function outcome(q: Question, answer: (Number|CheckerAnswer)?): Outcome =
  if (answer == null) "not-collected"
  else if (inRange(q.expected, value(answer))) "in-range"
  else "out-of-range"

/// Only "could not collect" fails a run. Out of range is an answer.
function failsRun(o: Outcome): Boolean = o == "not-collected"

/// Throws on an unknown dependency or a cycle; true otherwise. Validate before
/// anything runs or any secret is read.
function validGraph(questions: Mapping<Id, Question>): Boolean =
  questions.keys.every((id) -> visit(questions, id, List()))

local function visit(questions: Mapping<Id, Question>, id: String, trail: List<String>): Boolean =
  if (!questions.keys.contains(id)) throw("Unknown question dependency: \(id)")
  else if (trail.contains(id)) throw("Question dependency cycle at \(id)")
  else questions[id].dependencies.toList().every((dep) -> visit(questions, dep, trail + List(id)))
