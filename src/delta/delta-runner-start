#!/bin/bash
set -euo pipefail

[ "$(cat /usr/local/etc/delta-runner-enabled)" = true ] || exit 0
data="$HOME/.local/share/delta"
mkdir -p "$data"
exec >> "$data/runner.log" 2>&1

status=0
delta auth status || status=$?
case "$status" in
    0) ;;
    1)
        echo "Delta runner: not signed in; run 'delta auth login', then 'delta-runner-start'."
        exit 0
        ;;
    *)
        echo "Delta runner: cannot determine sign-in status (exit $status)."
        exit "$status"
        ;;
esac

# The lock is held by the runner, not the short-lived startup hook.
# A second container start must not register a duplicate runner.
setsid -f flock -n "$data/runner.lock" delta runner serve < /dev/null
