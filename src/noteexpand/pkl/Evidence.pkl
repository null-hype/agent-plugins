/// Evidence used by the noteexpand case. An enforcement value is a claim.
module noteexpand.Evidence

import "pkl:json"
import "pkl:reflect"

/// One finding: a component states a "never"; `enforced` says whether anything
/// in the system enforces it.
class Finding {
  /// The component that states the "never".
  component: String(!isEmpty)
  /// Path relative to the image root.
  source_path: String(!isEmpty)
  /// Text that appears verbatim at `source_path`.
  excerpt: String(!isEmpty)
  /// The thing the excerpt says must never happen.
  never: String(!isEmpty)
  /// The agent's claim about enforcement; grounding a quotation does not verify this claim.
  enforced: Boolean
  /// Additional source files supporting the claim; copied into Jev state.
  supporting_paths: Listing<String(!isEmpty)> = new {}
}

class EvidenceFile {
  findings: Listing<Finding>
}

local findingKeys: Set<String> = reflect.Class(Finding).properties.keys

local function finding(f: Any): Finding =
  if (!(f is Dynamic)) throw("finding must be an object, got \(f)")
  else if (f.toMap().keys.any((k) -> !findingKeys.contains(k))) throw("unexpected key(s) in finding: \(f.toMap().keys.filter((k) -> !findingKeys.contains(k)))")
  else f.toTyped(Finding)

function fromJson(text: String): EvidenceFile =
  let (raw = new json.Parser {}.parse(text))
  if (!(raw is Dynamic)) throw("top level must be an object")
  else if (raw.toMap().keys != Set("findings")) throw("top level must have exactly the key 'findings'")
  else if (!(raw.findings is Listing)) throw("'findings' must be an array")
  else new EvidenceFile {
    findings {
      for (f in raw.findings) { finding(f) }
    }
  }
