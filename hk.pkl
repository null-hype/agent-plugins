amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    // Add linters here. Examples:
    // ["prettier"] = Builtins.prettier
    // ["eslint"] = Builtins.eslint
    // ["ruff"] = Builtins.ruff

    // Or define custom steps:
    // ["custom"] {
    //     glob = "**/*.py"
    //     check = "mypy {{ files }}"
    // }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = (linters) {
            ["restic-check"] {
                check {
                    command = "bash .dagger/internal/devenv-base/hk/restic-check.sh"
                    effect = "read"
                }
            }
            // Vault existence contract (JIN-116): every `pass://` ref in
            // this repo's env files must resolve to a vault/item declared
            // in .dagger/internal/devenv-base/pkl/Vaults.pkl, and every
            // declared vault/item must actually exist in Proton Pass.
            // Read-only (vault/item listings only, no field values).
            ["vault-inventory"] {
                check {
                    command = "bash .dagger/internal/devenv-base/hk/capture-vault-inventory.sh && mise exec -- pkl test .dagger/internal/devenv-base/pkl/Vaults.test.pkl"
                    effect = "read"
                }
            }
            // CIT-150: the capability-spike axioms that need nothing but
            // pkl -- Inventory.pkl's declared-vs-observed check and
            // Reconcile.pkl's fact/grant/observation alignment check.
            // Deliberately not the whole spike: `go run .` / `go test
            // ./...` need a Go toolchain and rewrite the git-ignored
            // pkl/GrantState.pkl, so they stay manual. These two read
            // only committed fixtures and no credentials, which is what
            // makes them cheap enough to run on every `hk check`.
            // Reconcile.test.pkl's examples{} block also re-reads its own
            // -expected.pcf, so this step is what catches a diagnostic
            // message degrading while every assertion stays green.
            ["capability-axioms"] {
                dir = "capability-spike"
                check {
                    command = "mise exec -- pkl test pkl/Inventory.test.pkl pkl/Reconcile.test.pkl"
                    effect = "read"
                }
            }
            // Syncs pushed commits to the Linear "Development" release.
            // Runs here (not pre-push) since it's a post-push sync, not a
            // push gate -- a stale pass-cli session or a renamed vault
            // should never block `git push`. See
            // .dagger/internal/devenv-base/hk/linear-release-sync.sh.
            ["linear-release"] {
                check {
                    command = "bash .dagger/internal/devenv-base/hk/linear-release-sync.sh"
                    effect = "read"
                }
            }
        }
    }
    ["pre-push"] {
        steps {
            // Separate Claude, container-use, and Codex snapshots (disaster
            // recovery only). See .dagger/internal/devenv-base/hk/claude-session-backup.sh.
            ["claude-session-backup"] {
                check = "bash .dagger/internal/devenv-base/hk/claude-session-backup.sh --best-effort"
            }
        }
    }
}
