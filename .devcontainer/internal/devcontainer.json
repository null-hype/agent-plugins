{
  "name": "tidelands.dev",
  "image": "ghcr.io/null-hype/devenv-linear-agent:sha-ebaa8af19cbf8f9ec7cf573cdeee5a0f3786c7d3",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "username": "vscode" },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/null-hype/agent-plugins/pass-cli:1": {
      "tag": "claude-session-state",
      "model": "opus",
      "effort": "high"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--device=/dev/net/tun"
  ],
  "forwardPorts": [7880, 7881],
  "portsAttributes": {
    "7880": { "label": "Agent plugins Storybook", "onAutoForward": "silent" },
    "7881": { "label": "Tidelands Storybook", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .dagger/internal/devenv-base/.devcontainer/install-tools.sh && bash .devcontainer/storybook/setup.sh",
  "postStartCommand": "bash -lc 'bash .devcontainer/storybook/start.sh'",
  "postAttachCommand": "bash .dagger/internal/devenv-base/.devcontainer/verify-tools.sh",
  "remoteEnv": {
    "PROTON_PASS_KEY_PROVIDER": "fs",
    "GOOGLE_APPLICATION_CREDENTIALS": "/home/vscode/.config/gcloud/devpod-sa.json",
    "PASS_CLI_ENV_FILE": "${containerWorkspaceFolder}/.dagger/internal/devenv-base/.devcontainer/gcloud.env"
  },
  "remoteUser": "vscode"
}
