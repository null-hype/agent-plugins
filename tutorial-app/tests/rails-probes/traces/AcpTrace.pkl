/// The shape of an ACP trace fixture as the Client and Agent previews play it
/// (`src/stories/fixtures/*.json`, a lesson's `acp-trace.json`). Property order
/// is the order the JSON is written in.
module AcpTrace

class Trace {
  scenario: String
  frames: Listing<Frame>
  nextTurn: NextTurn?
}

abstract class Frame {
  actor: String
  action: String
}

class ClientFrame extends Frame {
  actor = "client"
  envelope: PromptEnvelope
  provenance: Provenance
}

class AgentFrame extends Frame {
  actor = "agent"
  speaker: String
  envelope: ResultEnvelope
  provenance: Provenance
}

class PromptEnvelope {
  jsonrpc = "2.0"
  id: Int
  method = "session/prompt"
  params: PromptParams
}

class PromptParams {
  sessionId: String
  prompt: Listing<TextBlock>
}

class TextBlock {
  type = "text"
  text: String
}

class ResultEnvelope {
  jsonrpc = "2.0"
  id: Int
  result: Result
}

class Result {
  stopReason = "end_turn"
  _meta: Meta
}

class Meta {
  diagnostic: Finding
  probes: Listing<Probe>
}

class Finding {
  code: String
  severity = "error"
  message: String
  subject: Row
  related: Listing<Row>
  evaluationId: String
}

class Probe {
  action: String
  question: String
  diagnostic: ProbeDiagnostic
}

class ProbeDiagnostic {
  severity = "error"
  code: String
  message: String
  evaluationId: String
  related: Listing<Row>
}

/// One evidence row. `revision` and `line` are left out of the JSON when unset.
class Row {
  role: String
  uri: String
  revision: String?
  line: Int?
  detail: String
}

/// A trace kept as one file per frame (`frame-<id>.json`) beside an index that
/// lists them (`acp-trace.json`), as the Jev report scenario plays it (CIT-318).
class FrameIndex {
  scenario: String
  frameIds: Listing<String>
  nextTurn: NextTurn?
}

/// A Jev report frame: the agent shows the report as recorded at one question.
class ReportFrame extends Frame {
  actor = "agent"
  provenance: RecordedProvenance
  /// The run's records up to this frame's question, as the report view reads them.
  reportView: Mapping<String, Any>
  speaker: String
  envelope: ReportEnvelope
  rebaseTodo: RebaseTodo
}

class RecordedProvenance {
  recordingId: String
  capturedAt: String
}

class ReportEnvelope {
  jsonrpc = "2.0"
  id: Int
  result: ReportResult
}

class ReportResult {
  _meta: ReportMeta
}

class ReportMeta {
  pins: Listing<Pin>
  verdict: Verdict
}

class Pin {
  id: String
  label: String
  text: String
}

class Verdict {
  channel: String
  status: String
  text: String
}

class RebaseTodo {
  commits: Listing<Commit>
  comment: String
}

/// A snapshot in the report's history. Only a question's own entry carries its diagnostic.
class Commit {
  sha: String
  subject: String
  diagnostic: ReportDiagnostic?
}

class ReportDiagnostic {
  severity: String
  code: String
  message: String
  evaluationId: String
  related: Listing<Row>
}

class Provenance {
  recordingId: String
  capturedAt: String
  scripted: String
}

class NextTurn {
  actor: String
  speaker: String
  action: String
}

/// JSON as `JSON.stringify(trace, null, 2)` writes it, so a rendered trace is
/// byte-comparable with the committed fixture: `nextTurn: null` is kept, a
/// row's unset `revision`/`line` are dropped.
renderer: JsonRenderer = new {
  omitNullProperties = false
  converters {
    [Row] = (row) -> row.toMap().filter((_, value) -> value != null)
    [Commit] = (commit) -> commit.toMap().filter((_, value) -> value != null)
  }
}
