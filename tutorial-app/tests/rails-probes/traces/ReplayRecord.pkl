/// CIT-334: one existing question, read through the shared record contract.
/// capture is written by ../capture-records.py from verified retained files.
module ReplayRecord

import "pkl:json"
import "CheckerProbes.pkl"
import "../../../../src/jev/pkl/Question.pkl"

local raw = new json.Parser {}.parse(read(read("prop:capture")).text)
local function evidence(d: Dynamic): Question.Evidence = d.toTyped(Question.Evidence)
local function resources(items: Listing): Listing<Question.Evidence> = new {
  for (item in items) { evidence(item) }
}
local function workspace(d: Dynamic): Question.WorkspaceState = new {
  id = d.id
  source = evidence(d.source)
  scope = d.scope
  inputs = resources(d.inputs)
  image = if (d.image == null) null else evidence(d.image)
  snapshot = if (d.snapshot == null) null else evidence(d.snapshot)
  limitations = d.limitations
}
evaluation: Question.EvaluationRecord = new {
  id = raw.id
  questionId = raw.questionId
  question = CheckerProbes.questions[questionId]
  before = workspace(raw.before)
  after = workspace(raw.after)
  transition {
    from = raw.transition.from
    to = raw.transition.to
    action = raw.transition.action
    evidence = resources(raw.transition.evidence)
  }
  delivery = raw.delivery.toTyped(Question.Delivery)
  declarations {
    for (d in raw.declarations) {
      new { text = d.text; evidence = evidence(d.evidence) }
    }
  }
  forecast = raw.forecast
  answer = if (raw.answer == null) null else raw.answer.toTyped(Question.CheckerAnswer)
  observations = resources(raw.observations)
}
valid: Boolean = if (Question.validRecord(evaluation)) true else throw("Invalid evaluation record")

output {
  value = if (valid) evaluation else throw("Invalid evaluation record")
  renderer = new JsonRenderer { omitNullProperties = false }
}
