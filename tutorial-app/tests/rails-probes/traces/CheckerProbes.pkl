/// CIT-312: the "Can the checker be trusted" traces, authored once.
///
/// What is CLAIMED lives here: the questions, the ids, the review's own words,
/// the structure of the trace. What the checker DID is not: each probe's exit
/// code and assertion counts are read from the `answer.json` the runner wrote
/// for that probe (`tests/rails-probes/rails-probes.tutorial.spec.ts`). Nothing
/// renders without a run directory to read them from.
///
/// The revision is an input. `revisions` is amended once per revision, with
/// only what that revision's review and PR say.
///
///   pkl eval -m <out> CheckerProbes.pkl \
///     -p state=S1 -p checker=<sha> -p reproductionId=<id> -p run=<dir>
///
/// writes `<out>/starter.json`, `<out>/solved.json` and `<out>/lesson.md` (the
/// state's lesson prose, CIT-316). `chapter` lists the states in lesson order,
/// and needs no run. `<dir>` is a
/// reproduction directory as the runner lays it out
/// (`evidence/cit-294-probe-reproduction-v1/reproduction/S1` is the committed one).
module CheckerProbes

import "pkl:json"

import "AcpTrace.pkl"
import "../../../../src/jev/pkl/Question.pkl"
import "../../../../src/cve-2026-66066/questions/checker/Question.pkl" as installedChecker

/// The checker state the probes were asked of (S1 = PR 117, S2 = PR 118).
state: String = read("prop:state")
/// The checker commit, in full. Rows cite its first eight characters.
checker: String = read("prop:checker")
reproductionId: String = read("prop:reproductionId")
/// Where the runner wrote this state's answers.
run: String = read("prop:run")

/// One revision's amendment: what its PR and its review say. Nothing measured.
class Revision {
  pr: Int
  /// The review of this revision; null when none is recorded.
  review: Int?
  /// Who replies on Solve: the reviewer, or the checker itself when no review is recorded.
  reviewer: String = "bob"
  replyAction: String = "review PR \(pr)"
  ticket: String
  sessionId: String
  /// The commit message the Client holds: the subject question, then the PR's claims.
  prompt: String
  capturedAt: String
  /// The finding's id in the recorded review history
  /// (`src/lib/reviewHistory/declarations.ts`), verbatim (CIT-313).
  findingId: String
  /// Its code, where the history spells it differently (a second-hand finding).
  findingCode: String = findingId
  findingSeverity: String = "error"
  /// The finding, in the review's words.
  finding: String
  /// Where the review points.
  subject: AcpTrace.Row
  /// The review's own sentence about the probes, as captured.
  reviewSaid: AcpTrace.Row
  /// The checker code that explains the answer.
  axiom: AcpTrace.Row
  promptScripted: String
  replyScripted: String
  /// The probes the pull request claims the check now flags: the author's
  /// forecast for each, which the run then answers. Its words are in `prompt`.
  claimed: Listing<Question.Id> = new {}
  /// Where the pull request makes that claim.
  claimSaid: AcpTrace.Row?
  /// This revision's lesson in the chapter (CIT-316).
  lesson: Question.Lesson
}

revisions: Mapping<String, Revision> = new {
  ["S1"] {
    pr = 117
    review = 1
    ticket = "CIT-294"
    sessionId = "sess_cit294-01"
    prompt =
      """
      Can the check tell a real read of the private file from a forged one?

      Alice, #117:
      Runs the real Rails -> libvips `matload` -> libmatio/HDF5 -> dummy file bytes -> returned variant chain live, byte-exact.
      Four runs on one pinned Rails 7.0.10/libvips 8.13.0/libmatio 1.5.23 image: unblocked MAT canary (disclosure), blocked MAT canary (refused, no disclosure), PNG control under both blocking states.
      `pkl test cit294.test.pkl` from `cit-294/` passes (8 facts / 28 asserts / 4 examples) against the live observations
      """
    capturedAt = "2026-10-04T01:15:37.196Z"
    findingId = "review-1.finding-1"
    finding = "The independent file-read evidence never reaches the checker."
    subject {
      role = "observation"
      uri = "\(checkerDir)/run_arms.sh"
      revision = short
      line = 21
