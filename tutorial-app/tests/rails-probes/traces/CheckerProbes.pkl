}

/// The revisions in chapter order, by `lesson.order`, which must count 1, 2, ...
chapter: List<String> =
  let (keys = revisions.keys.toList().sortBy((k) -> revisions[k].lesson.order))
    if (keys.toList().mapIndexed((i, k) -> revisions[k].lesson.order == i + 1).every((it) -> it)) keys
    else throw("lesson orders in `revisions` must count 1 to \(keys.length)")

local claims =
  revisions.getOrNull(state)
    ?? throw("no claims for state \(state): amend `revisions` in CheckerProbes.pkl")
local short = checker.take(8)
local checkerDir = "docs/investigations/CIT-265/cit-294"
local reproductionUri = "evidence/cit-294-probe-reproduction-v1/reproduction/\(state)"
local finding = claims.findingId
/// The revisions up to this one, latest first.
local sinceStart: List<String> = chapter.take(chapter.indexOf(state) + 1).reverse()
/// The finding a probe tests here: the one this revision's review names, or
/// else the latest earlier review's (a probe it does not speak to carries over).
local function findingOf(q: Probe): String =
  sinceStart.map((s) -> q.findingAt.getOrNull(s)).filterNonNull().first
/// Whether the checker reads each arm's embedded trace (from #120 on).
local embedded: Boolean =
  read("../../../evidence/cit-294-review-history-v1/files/\(checker)/\(checkerDir)/observations/mat-blocked.json").text.contains("\"independent_trace_text\"")
local function whatOf(q: Probe): String = if (embedded && q.whatEmbedded != null) q.whatEmbedded!! else q.what
local function actionOf(q: Probe): String = if (embedded && q.actionEmbedded != null) q.actionEmbedded!! else q.action
/// The history's run id (`REVIEW_HISTORY_RUN_ID` in `src/lib/reviewHistory/identity.ts`):
/// evaluation ids are `<run>:<finding id>`, as the history spells them (CIT-313).
local historyRun = "cit-294-117-118-120"

// The two questions, the same at every revision. Each is a shared Question
// (CIT-315) the checker answers: a checker that can be trusted notices the
// probe, so `expected` is "noticed". An answer outside that is still an answer,
// told in the lesson; only an `answer.json` that is not there fails.
class Probe extends Question.Question {
  name: Question.Id
  action: String
  question: String
  did: String
  what: String
  /// The finding this probe tests at each revision, by its id in the review
  /// history: the review that raised it, or the one that reassessed it.
  findingAt: Mapping<String, String>
  /// The recorded observation the probe edits (`observations/<arm>.json`), and
  /// the field the lens opens at; null for a probe of the trace.
  arm: String?
  field: String?
  /// Where each revision's review speaks to it, by line.
  reviewLine: Mapping<String, Int>
  /// What the probe does, and to what, from #120 on, where the checker reads
  /// each arm's embedded trace (`independent_trace_text`) instead of the transcript.
  actionEmbedded: String?
  whatEmbedded: String?
  /// The revision whose review raised it. It is asked of that revision and every
  /// later one, never an earlier one, which would leak a later review back.
  from: String = "S1"
  judge = new Question.Checker {}
  collector = name
  requiredEvidence { "exitCode" }
  expected { min = 1; max = 1 }
}
/// The Questions this part asks, by id (CIT-317). `playwright.questions.config.ts`
/// makes one Playwright project of each, and the collector each names runs it at
/// every revision. Needs no run.
questions: Mapping<Question.Id, Probe> = new {
  for (q in offered) { [q.name] = q }
}

/// The probes in the order the reviewer offers them.
local offered: List<Probe> = List(forgedRead, deletedTrace, genericCrash, emptiedBytes, corruptedPixels, swappedSource, changedConfig, proseMention, failedOpen, otherDirectory)
/// The probes this revision is asked: those raised by its own review or an earlier one.
local asked: List<Probe> = offered.filter((q) -> revisions[q.from].lesson.order <= claims.lesson.order)

local deletedTrace = new Probe {
  judge = installedChecker.question.judge
  collector = installedChecker.question.collector
  requiredEvidence = installedChecker.question.requiredEvidence
  expected = installedChecker.question.expected
  name = "deleted-trace"
  action = "removed canary-reads.txt, the whole retained trace"
  question = "Does the check fail when the trace is deleted?"
  did = "Deleting the trace"
  what = "canary-reads.txt removed"
  actionEmbedded = "emptied the blocked arm's embedded trace, the trace the checker reads"
  whatEmbedded = "the blocked MAT arm's embedded trace emptied"
  findingAt { ["S1"] = "review-1.finding-1"; ["S2"] = "review-2.gap-1"; ["S3"] = "review-3.finding-1" }
  reviewLine { ["S1"] = 5; ["S2"] = 7; ["S3"] = 28 }
}
local forgedRead = new Probe {
  name = "forged-read"
  action = "forged a read of the private file into the blocked arm"
  question = "Does the check fail when a read of the private file is forged?"
  did = "Forging a read of the private file"
  what = "an openat of the private file, /work/dummy-canary.txt, added to the mat-blocked arm of canary-reads.txt"
  actionEmbedded = "forged a read of the private file into the blocked arm's embedded trace"
  whatEmbedded = "an openat of the private file, /work/dummy-canary.txt, added to the blocked MAT arm's embedded trace"
  findingAt { ["S1"] = "review-1.finding-1"; ["S2"] = "review-2.gap-1" }
  reviewLine { ["S1"] = 5; ["S2"] = 7 }
}
local genericCrash = new Probe {
  name = "generic-crash"
  action = "recorded the blocked arm's refusal as RuntimeError: disk full"
  question = "Does the check fail when the block is a generic crash?"
  did = "Recording the block as a generic crash"
  what = "the blocked MAT arm refused with RuntimeError: disk full instead of the matload block"
  findingAt { ["S1"] = "review-1.finding-2"; ["S2"] = "review-2.reassessed.findings-2-3" }
  arm = "mat-blocked"
  field = "variant_error"
  reviewLine { ["S1"] = 7; ["S2"] = 3 }
}
local emptiedBytes = new Probe {
  name = "emptied-bytes"
  action = "emptied the private file's returned bytes and set their count to 0"
  question = "Does the check fail when the returned bytes are emptied?"
  did = "Emptying the returned bytes"
  what = "the unblocked MAT arm's returned bytes emptied and their count set to 0"
  findingAt { ["S1"] = "review-1.finding-3"; ["S2"] = "review-2.reassessed.findings-2-3" }
  arm = "mat-unblocked"
  field = "returned_bytes_hex"
  reviewLine { ["S1"] = 9; ["S2"] = 3 }
}
local corruptedPixels = new Probe {
  name = "corrupted-pixels"
  action = "set the blocked PNG control's pixels to ffffffff"
  question = "Does the check fail when the PNG control's pixels are corrupted?"
  did = "Corrupting the PNG control's pixels"
  what = "the blocked PNG control's pixels set to ffffffff"
  findingAt { ["S1"] = "review-1.finding-3"; ["S2"] = "review-2.reassessed.findings-2-3" }
  arm = "png-blocked"
  field = "returned_bytes_hex"
  reviewLine { ["S1"] = 9; ["S2"] = 3 }
}
local swappedSource = new Probe {
  name = "swapped-source"
  action = "replaced the blocked arm's source sha256 with another valid one"
  question = "Does the check fail when the blocked arm records a different upload?"
  did = "Recording a different upload for the blocked arm"
  what = "the blocked MAT arm's source sha256 replaced with another valid one"
  from = "S2"
  findingAt { ["S2"] = "review-2.gap-2" }
  arm = "mat-blocked"
  field = "independent_source_sha256"
  reviewLine { ["S2"] = 9 }
}
local changedConfig = new Probe {
  name = "changed-config"
  action = "set the blocked arm's Rails defaults to 6.1 and its variant processor to mini_magick"
  question = "Does the check fail when the blocked arm records a different configuration?"
  did = "Recording a different configuration for the blocked arm"
  what = "the blocked MAT arm's Rails defaults set to 6.1 and its variant processor to mini_magick"
  from = "S2"
  findingAt { ["S2"] = "review-2.gap-2" }
  arm = "mat-blocked"
  field = "independent_rails_load_defaults"
  reviewLine { ["S2"] = 9 }
}
// Review 3's edits, known second-hand: the unblocked arm's real read of the
// private file replaced by something that only looks like one.
local proseMention = new Probe {
  name = "prose-mention"
  action = "replaced the unblocked arm's real read with a prose mention of the private file"
  question = "Does the check fail when the real read is only a mention of the private file?"
  did = "Replacing the real read with a prose mention of the private file"
  what = "the unblocked MAT arm's real read of the private file replaced by a prose mention of it"
  from = "S3"
  findingAt { ["S3"] = "review-3.finding-2" }
  arm = "mat-unblocked"
  field = "independent_trace_text"
  reviewLine { ["S3"] = 29 }
}
local failedOpen = new Probe {
  name = "failed-open"
  action = "replaced the unblocked arm's real read with a failed (EACCES) open of the private file"
  question = "Does the check fail when the real read is a failed open?"
  did = "Replacing the real read with a failed open of the private file"
  what = "the unblocked MAT arm's real read of the private file replaced by a failed (EACCES) open of it"
  from = "S3"
  findingAt { ["S3"] = "review-3.finding-2" }
  arm = "mat-unblocked"
  field = "independent_trace_text"
  reviewLine { ["S3"] = 29 }
}
local otherDirectory = new Probe {
  name = "other-directory"
  action = "replaced the unblocked arm's real read with an open of /tmp/dummy-canary.txt"
  question = "Does the check fail when the real read is of a same-named file elsewhere?"
  did = "Replacing the real read with an open of a same-named file elsewhere"
  what = "the unblocked MAT arm's real read of the private file replaced by an open of /tmp/dummy-canary.txt"
  from = "S3"
  findingAt { ["S3"] = "review-3.finding-2" }
  arm = "mat-unblocked"
  field = "independent_trace_text"
  reviewLine { ["S3"] = 29 }
}

local function answer(q: Probe): Question.CheckerAnswer =
  new json.Parser {}.parse(read("\(run)/probes/\(q.name)/answer.json")).toTyped(Question.CheckerAnswer)

local function counts(a: Question.CheckerAnswer): String =
  if (a.assertsTotal == null)
    "no assertion count (the checker stopped before counting)"
  else
    "\(a.assertsPassed) of \(a.assertsTotal) assertions pass"

/// What the checker said to a probe. Either answer is data (CIT-311).
local function answerText(q: Probe): String =
  let (a = answer(q))
    if (Question.noticed(a))
      "\(q.did) made the check fail\(if (a.assertsTotal == null) "" else ": \(a.assertsPassed) of \(a.assertsTotal) assertions passed") (pkl test exit \(a.exitCode))."
    else
      "\(q.did) still left all \(a.assertsTotal) assertions passing."

/// What the run found, in words the lesson can end on. Both answers are told.
local foundSame = asked.every((q) -> !Question.noticed(answer(q)))
local function each(q: Probe, what: String): String =
  let (a = answer(q))
    "\(what) \(if (Question.noticed(a)) "made it fail (\(counts(a)))" else "still left all \(a.assertsTotal) assertions passing")"
local found: String =
  if (foundSame) "still passing all \(answer(deletedTrace).assertsTotal) assertions, whichever edit Bob made"
  else
    let (missed = asked.filter((q) -> !Question.noticed(answer(q))))
      if (missed.isEmpty) "failing the suite on every one of the \(asked.length) edits"
      else "catching \(asked.length - missed.length) of Bob's \(asked.length) edits, and still passing every assertion for the rest: \(missed.map((q) -> q.did.toLowerCase()).join("; ")); a reproduction of what each edit did is the lens's last row"

/// The row that shows what a probe produced. Labelled a reproduction, never the reviewers' own output.
local function reproduction(q: Probe): AcpTrace.Row =
  let (a = answer(q))
    new {
      role = "observation"
      // The lesson holds the run's result after Solve, at this path.
      uri = "reproduction/\(state)/probes/\(q.name)/result.txt"
      revision = state
      line = 4
      detail =
        "REPRODUCTION \(reproductionId) (a new run, not the reviewers' own output): \(whatOf(q)); checker \(short); pkl test exit \(a.exitCode), \(counts(a))"
    }

/// The trace as retained, which the lesson holds after Solve.
local pinnedTrace: List<String> =
  read("../../../evidence/cit-294-review-history-v1/files/\(checker)/\(checkerDir)/canary-reads.txt").text.split("\n")

local transcript: AcpTrace.Row = new {
  role = "observation"
  uri = "reproduction/\(state)/runs/baseline/canary-reads.txt"
  revision = state
  line = 1
  detail =
    if (embedded) "the committed strace transcript of the four arms; from #120 on, the checker reads each arm's embedded copy instead"
    else "the strace transcript of the four arms, as retained: what the deleted-trace probe removes"
}

/// The trace as the forged-read probe left it, at the openat it added: the line
/// after the blocked arm's header and the heading below it.
local forgedTrace: AcpTrace.Row = new {
  role = "observation"
  uri = "reproduction/\(state)/probes/forged-read/canary-reads.txt"
  revision = state
  line = pinnedTrace.indexOf("### ARM: mat-blocked") + 3
  detail = "canary-reads.txt as the probe left it: \(forgedRead.what)"
}

local notRetained: AcpTrace.Row = new {
  role = "observation"
  uri = "\(finding)/mutation-output"
  detail = "expected the deleted-trace run's output | actual -- not retained -- [missing]"
}

/// The record a probe edited, as the probe left it, at the field it changed.
local function editedAt(q: Probe, arm: String, field: String): AcpTrace.Row =
  let (pinned = read("../../../evidence/cit-294-review-history-v1/files/\(checker)/\(checkerDir)/observations/\(arm).json").text.split("\n"))
    new {
      role = "observation"
      // The lesson holds the edited record after Solve, at this path.
      uri = "reproduction/\(state)/probes/\(q.name)/observations/\(arm).json"
      revision = state
      line = pinned.findIndex((l) -> l.trimStart().startsWith("\"\(field)\":")) + 1
      detail = "\(arm).json as the probe left it: \(whatOf(q))"
    }

/// The first row a probe's lens opens: the edit itself, in the trace the
/// checker reads or the record the probe changed.
local function edit(q: Probe): AcpTrace.Row =
  if (q.arm != null) editedAt(q, q.arm!!, q.field!!)
  else if (embedded) editedAt(q, "mat-blocked", "independent_trace_text")
  else if (q == forgedRead) forgedTrace
  else transcript

/// Where this revision's review speaks to a probe.
local function raised(q: Probe): AcpTrace.Row = (claims.reviewSaid) {
  line = q.reviewLine[state]
}

local function claimedHere(q: Probe): Boolean = claims.claimed.toList().contains(q.name)

/// The author's claim about a probe, when her pull request makes one: her
/// forecast that the check now flags it, and whether the run bears it out.
local function claimNote(q: Probe): String =
  if (claimedHere(q))
    " Alice claimed #\(claims.pr) flags it; it \(if (Question.noticed(answer(q))) "does" else "does not")."
  else ""

/// What a probe's lens opens: the edit, where this revision's review speaks to
/// it, where the pull request claims it, why it went as it did, and the run.
local function rowsOf(q: Probe): Listing<AcpTrace.Row> = new {
  edit(q)
  when (q.reviewLine.containsKey(state)) { raised(q) }
  when (claimedHere(q) && claims.claimSaid != null) { claims.claimSaid!! }
  when (q == forgedRead) { claims.axiom }
  when (q == deletedTrace && claims.review != null) { notRetained }
  reproduction(q)
}


local function probe(q: Probe, rows: Listing<AcpTrace.Row>): AcpTrace.Probe = new {
  action = actionOf(q)
  question = q.question
  diagnostic {
    severity = if (Question.noticed(answer(q))) "info" else "error"
    code = "\(findingOf(q)).\(q.name)"
    message = "\(code): \(answerText(q))\(claimNote(q))"
    evaluationId = "\(historyRun):\(code)"
    related = rows
  }
}

local recording = if (claims.review != null) "cit294-review-\(claims.review)" else "cit294-\(state.toLowerCase())"

local ask: AcpTrace.ClientFrame = new {
  action = "send prompt"
  speaker = "alice"
  envelope {
    id = 1
    params {
      sessionId = claims.sessionId
      prompt { new { text = claims.prompt } }
    }
  }
  provenance {
    recordingId = "\(recording)#0"
    capturedAt = claims.capturedAt
    scripted = claims.promptScripted
  }
}

starter: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames { ask }
  nextTurn {
    actor = "agent"
    speaker = claims.reviewer
    action = claims.replyAction
  }
}

solved: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames {
    ask
    new AcpTrace.AgentFrame {
      action = "reply with finding"
      speaker = claims.reviewer
      envelope {
        id = 1
        result {
          _meta {
            diagnostic {
              code = claims.findingCode
              severity = claims.findingSeverity
              message = "\(code): \(claims.finding)"
              subject = claims.subject
              related {
                claims.reviewSaid
                claims.axiom
                transcript
                notRetained
                for (q in asked) { reproduction(q) }
              }
              evaluationId = "\(historyRun):\(finding)"
            }
            probes {
              for (q in asked) { probe(q, rowsOf(q)) }
            }
          }
        }
      }
      provenance {
        recordingId = "\(recording)#1"
        capturedAt = claims.capturedAt
        scripted = claims.replyScripted
      }
    }
  }
  nextTurn = null
}

output {
  files {
    ["starter.json"] { value = starter; renderer = AcpTrace.renderer }
    ["solved.json"] { value = solved; renderer = AcpTrace.renderer }
    ["lesson.md"] { text = claims.lesson.prose + "\n" }
  }
}
