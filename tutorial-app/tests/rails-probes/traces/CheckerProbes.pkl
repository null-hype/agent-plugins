/// CIT-312: the "Can the checker be trusted" traces, authored once.
///
/// What is CLAIMED lives here: the questions, the ids, the review's own words,
/// the structure of the trace. What the checker DID is not: each probe's exit
/// code and assertion counts are read from the `answer.json` the runner wrote
/// for that probe (`tests/rails-probes/rails-probes.tutorial.spec.ts`). Nothing
/// renders without a run directory to read them from.
///
/// The revision is an input. `revisions` is amended once per revision, with
/// only what that revision's review and PR say.
///
///   pkl eval -m <out> CheckerProbes.pkl \
///     -p state=S1 -p checker=<sha> -p reproductionId=<id> -p run=<dir>
///
/// writes `<out>/starter.json`, `<out>/solved.json` and `<out>/lesson.md` (the
/// state's lesson prose, CIT-316). `chapter` lists the states in lesson order,
/// and needs no run. `<dir>` is a
/// reproduction directory as the runner lays it out
/// (`evidence/cit-294-probe-reproduction-v1/reproduction/S1` is the committed one).
module CheckerProbes

import "pkl:json"

import "AcpTrace.pkl"
import "../../../../src/jev/pkl/Question.pkl"

/// The checker state the probes were asked of (S1 = PR 117, S2 = PR 118).
state: String = read("prop:state")
/// The checker commit, in full. Rows cite its first eight characters.
checker: String = read("prop:checker")
reproductionId: String = read("prop:reproductionId")
/// Where the runner wrote this state's answers.
run: String = read("prop:run")

/// One revision's amendment: what its PR and its review say. Nothing measured.
class Revision {
  pr: Int
  review: Int
  ticket: String
  sessionId: String
  /// The commit message the Client holds: the subject question, then the PR's claims.
  prompt: String
  capturedAt: String
  /// The finding's id in the recorded review history
  /// (`src/lib/reviewHistory/declarations.ts`), verbatim (CIT-313).
  findingId: String
  /// The finding, in the review's words.
  finding: String
  /// Where the review points.
  subject: AcpTrace.Row
  /// The review's own sentence about the probes, as captured.
  reviewSaid: AcpTrace.Row
  /// The checker code that explains the answer.
  axiom: AcpTrace.Row
  promptScripted: String
  replyScripted: String
  /// This revision's lesson in the chapter (CIT-316).
  lesson: Question.Lesson
}

revisions: Mapping<String, Revision> = new {
  ["S1"] {
    pr = 117
    review = 1
    ticket = "CIT-294"
    sessionId = "sess_cit294-01"
    prompt =
      """
      CIT-294: Can the check tell a real file read from a forged one?

      Run the Rails → libvips → libmatio/HDF5 chain live, under strace.
      Four arms: MAT canary and PNG control, each unblocked and blocked.
      pkl test: 8 facts, 28 asserts, all passing.
      """
    capturedAt = "2026-10-04T01:15:37.196Z"
    findingId = "review-1.finding-1"
    finding = "The independent file-read evidence never reaches the checker."
    subject {
      role = "observation"
      uri = "\(checkerDir)/run_arms.sh"
      revision = short
      line = 21
      detail = "run_arms.sh:21-30 prints filtered strace output, but Pkl never consumes it"
    }
    reviewSaid {
      role = "observation"
      uri = "evidence/cit-294-review-history-v1/captures/linear-CIT-294-comment-97e70a90.md"
      line = 5
      detail =
        "deleting the trace entirely, or replacing it with a dummy-file read in the blocked arm, still left all 28 assertions passing"
    }
    axiom {
      role = "axiom"
      uri = "\(checkerDir)/Reconcile.pkl"
      revision = short
      line = 17
      detail =
        "check(claim, observed) takes a claim and an observation; nothing derived from the strace transcript reaches it"
    }
    promptScripted =
      "ACP framing and the subject question authored; the body is condensed from the PR 117 description."
    replyScripted = "ACP framing authored; the review text is retrieved verbatim."
    lesson {
      order = 1
      title = "Can the check tell a real file read from a forged one"
      prose =
        """
        # Can the check tell a real file read from a forged one?

        Pull request #117 passed its check. The **Client** holds the commit that change
        was written as, in the form this case gives every change: a message whose
        subject line is a question. Unfold it to read the body.

        Select **Solve** to ask the reviewer. Grey suggested lines appear below the
        commit: the questions it asked itself to split yours, one by deleting the trace
        and one by forging a read. Press **Tab** to accept the one shown, or **Alt+]** to
        switch to the other first. You can take either, or both. Each accepted line
        becomes text in your editor, and each is checked. The **Agent** shows what the
        reviewer was deciding to check, and its finding only after you accept.

        Click the lens above an accepted line, **`review-1.finding-1.deleted-trace`**
        or **`review-1.finding-1.forged-read`**, to open the evidence behind it. One row
        is the part nobody kept: the output of the review's own test run. Next to it is a
        **reproduction**: the same probe run again, for real, against the checker as
        submitted. It is a new run, not the reviewers' output, and it shows the checker
        \(found). The files for it appear in the editor after Solve.
        """
    }
  }
  ["S2"] {
    pr = 118
    review = 2
    ticket = "CIT-297"
    sessionId = "sess_cit294-02"
    prompt =
      """
      CIT-297: Can the strengthened check tell a real file read from a forged one?

      Independent read evidence now reaches the checker: run_arms.sh derives the dummy-file open count outside the Ruby process.
      Deleting the trace, or forging a dummy-file read into the blocked arm, is now flagged.
      pkl test: 18 facts, 56 asserts, all passing.
      """
    capturedAt = "2026-10-04"
    findingId = "review-2.gap-1"
    finding = "The trace negative controls mutate the derived count, not the retained trace."
    subject {
      role = "observation"
      uri = "\(checkerDir)/cit294.test.pkl"
      revision = short
      line = 98
      detail =
        "cit294.test.pkl:98-104 changes independent_dummy_file_openat_count; no negative control alters the retained trace"
    }
    reviewSaid {
      role = "observation"
      uri = "evidence/cit-294-review-history-v1/captures/linear-CIT-297-comment-271bc302.md"
      line = 7
      detail =
        "deleting canary-reads.txt entirely or replacing it with a blocked-arm dummy-file read still passes all 56 assertions and produces empty diagnostics for every arm"
    }
    axiom {
      role = "axiom"
      uri = "\(checkerDir)/Reconcile.pkl"
      revision = short
      line = 95
      detail =
        "independent-read-mismatch compares the observed open count with the claim; nothing re-derives that count from canary-reads.txt"
    }
    promptScripted =
      "ACP framing and the subject question authored; the body is condensed from the PR 118 description. capturedAt is the evidence bundle's collection date."
    replyScripted =
      "ACP framing authored; the review text is retrieved verbatim. capturedAt is the evidence bundle's collection date."
    lesson {
      order = 2
      title = "Can the strengthened check tell a real file read from a forged one"
      prose =
        """
        # Can the strengthened check tell a real file read from a forged one?

        Pull request #118 answers the first review. Its description says the
        independent read evidence now reaches the checker, and that deleting the trace,
        or forging a dummy-file read into the blocked arm, "is now flagged". The
        **Client** holds the commit that change was written as.

        The two questions are the ones asked of #117, word for word. Select **Solve**
        to ask the reviewer, and take either suggestion with **Tab** (or **Alt+]** to
        switch first), or both. The **Agent** holds back its finding until you accept.

        Open the lens above an accepted line, **`review-2.gap-1.deleted-trace`** or
        **`review-2.gap-1.forged-read`**. The **reproduction** row is the probe run
        again, for real, against the checker as #118 submitted it. It is a new run, not
        the reviewer's own output, which was not kept. It shows the checker \(found).\(
          if (foundSame) " The new tests change the derived open count; neither probe touches that count, because both change the retained trace." else ""
        ) The files for each run
        appear in the editor after Solve, beside the first lesson's.
        """
    }
  }
}

/// The revisions in chapter order, by `lesson.order`, which must count 1, 2, ...
chapter: List<String> =
  let (keys = revisions.keys.toList().sortBy((k) -> revisions[k].lesson.order))
    if (keys.toList().mapIndexed((i, k) -> revisions[k].lesson.order == i + 1).every((it) -> it)) keys
    else throw("lesson orders in `revisions` must count 1 to \(keys.length)")

local claims =
  revisions.getOrNull(state)
    ?? throw("no claims for state \(state): amend `revisions` in CheckerProbes.pkl")
local short = checker.take(8)
local checkerDir = "docs/investigations/CIT-265/cit-294"
local reproductionUri = "evidence/cit-294-probe-reproduction-v1/reproduction/\(state)"
local finding = claims.findingId
/// The history's run id (`REVIEW_HISTORY_RUN_ID` in `src/lib/reviewHistory/identity.ts`):
/// evaluation ids are `<run>:<finding id>`, as the history spells them (CIT-313).
local historyRun = "cit-294-117-118-120"

// The two questions, the same at every revision. Each is a shared Question
// (CIT-315) the checker answers: a checker that can be trusted notices the
// probe, so `expected` is "noticed". An answer outside that is still an answer,
// told in the lesson; only an `answer.json` that is not there fails.
local class Probe extends Question.Question {
  name: Question.Id
  action: String
  question: String
  did: String
  what: String
  judge = new Question.Checker {}
  collector = name
  requiredEvidence { "exitCode" }
  expected { min = 1; max = 1 }
}
local deletedTrace = new Probe {
  name = "deleted-trace"
  action = "removed canary-reads.txt, the whole retained trace"
  question = "Does the check fail when the trace is deleted?"
  did = "Deleting the trace"
  what = "canary-reads.txt removed"
}
local forgedRead = new Probe {
  name = "forged-read"
  action = "forged a dummy-file read into the blocked arm"
  question = "Does the check fail when a dummy-file read is forged?"
  did = "Forging a dummy-file read"
  what = "a dummy-file openat added to the mat-blocked arm of canary-reads.txt"
}

local function answer(q: Probe): Question.CheckerAnswer =
  new json.Parser {}.parse(read("\(run)/probes/\(q.name)/answer.json")).toTyped(Question.CheckerAnswer)

local function counts(a: Question.CheckerAnswer): String =
  if (a.assertsTotal == null)
    "no assertion count (the checker stopped before counting)"
  else
    "\(a.assertsPassed) of \(a.assertsTotal) assertions pass"

/// What the checker said to a probe. Either answer is data (CIT-311).
local function answerText(q: Probe): String =
  let (a = answer(q))
    if (Question.noticed(a))
      "\(q.did) made the check fail\(if (a.assertsTotal == null) "" else ": \(a.assertsPassed) of \(a.assertsTotal) assertions passed") (pkl test exit \(a.exitCode))."
    else
      "\(q.did) still left all \(a.assertsTotal) assertions passing."

/// What the run found, in words the lesson can end on. Both answers are told.
local foundSame = List(deletedTrace, forgedRead).every((q) -> !Question.noticed(answer(q)))
local function each(q: Probe, what: String): String =
  let (a = answer(q))
    "\(what) \(if (Question.noticed(a)) "made it fail (\(counts(a)))" else "still left all \(a.assertsTotal) assertions passing")"
local found: String =
  if (foundSame) "still passing all \(answer(deletedTrace).assertsTotal) assertions"
  else "different answers: \(each(deletedTrace, "deleting the trace")), and \(each(forgedRead, "forging a read"))"

/// The row that shows what a probe produced. Labelled a reproduction, never the reviewers' own output.
local function reproduction(q: Probe): AcpTrace.Row =
  let (a = answer(q))
    new {
      role = "observation"
      uri = "\(reproductionUri)/probes/\(q.name)/result.txt"
      detail =
        "REPRODUCTION \(reproductionId) (a new run, not the reviewers' own output): \(q.what); checker \(short); pkl test exit \(a.exitCode), \(counts(a))"
    }

local transcript: AcpTrace.Row = new {
  role = "observation"
  uri = "\(checkerDir)/canary-reads.txt"
  revision = short
  line = 1
  detail = "the strace transcript of the four arms: committed, and read by no check"
}

local notRetained: AcpTrace.Row = new {
  role = "observation"
  uri = "\(finding)/mutation-output"
  detail = "expected the deleted-trace run's output | actual -- not retained -- [missing]"
}

local function probe(q: Probe, rows: Listing<AcpTrace.Row>): AcpTrace.Probe = new {
  action = q.action
  question = q.question
  diagnostic {
    code = "\(finding).\(q.name)"
    message = "\(code): \(answerText(q))"
    evaluationId = "\(historyRun):\(code)"
    related = rows
  }
}

local ask: AcpTrace.ClientFrame = new {
  action = "send prompt"
  envelope {
    id = 1
    params {
      sessionId = claims.sessionId
      prompt { new { text = claims.prompt } }
    }
  }
  provenance {
    recordingId = "cit294-review-\(claims.review)#0"
    capturedAt = claims.capturedAt
    scripted = claims.promptScripted
  }
}

starter: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames { ask }
  nextTurn {
    actor = "agent"
    speaker = "reviewer"
    action = "review PR \(claims.pr)"
  }
}

solved: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames {
    ask
    new AcpTrace.AgentFrame {
      action = "reply with finding"
      speaker = "reviewer"
      envelope {
        id = 1
        result {
          _meta {
            diagnostic {
              code = finding
              message = "\(finding): \(claims.finding)"
              subject = claims.subject
              related {
                claims.reviewSaid
                claims.axiom
                transcript
                notRetained
                reproduction(deletedTrace)
                reproduction(forgedRead)
              }
              evaluationId = "\(historyRun):\(finding)"
            }
            probes {
              probe(deletedTrace, new Listing {
                claims.reviewSaid
                transcript
                notRetained
                reproduction(deletedTrace)
              })
              probe(forgedRead, new Listing {
                claims.reviewSaid
                claims.axiom
                reproduction(forgedRead)
              })
            }
          }
        }
      }
      provenance {
        recordingId = "cit294-review-\(claims.review)#1"
        capturedAt = claims.capturedAt
        scripted = claims.replyScripted
      }
    }
  }
  nextTurn = null
}

output {
  files {
    ["starter.json"] { value = starter; renderer = AcpTrace.renderer }
    ["solved.json"] { value = solved; renderer = AcpTrace.renderer }
    ["lesson.md"] { text = claims.lesson.prose + "\n" }
  }
}
