/// CIT-328: a part-5 lesson, one per revision of the document app, told as a
/// review in the same form as part 4's (`cit294-review-v1`, `CheckerProbes.pkl`).
///
/// The Client holds the revision as a commit whose subject is its question and
/// whose body is the authorization policy the run recorded. Jev is the reviewer:
/// the Questions asked of that revision come back as suggestions, the same words
/// at every revision, and each accepted line carries Jev's answer and the
/// evidence it judged.
///
/// The chapter is one ACP session, stepped through a turn at a time: a lesson
/// starts from the previous lesson's solved trace with its own revision's
/// prompt added, and Solve adds the reviewer's reply.
///
/// What is CLAIMED lives here and in `report-expected.pcf`: the structure, the
/// labels, the questions and the lesson text. What the run DID is not: every
/// score, policy, HTTP exchange and time is read from the part's run directory,
/// where the `jev/<id>` Question projects' collectors wrote them.
///
///   pkl eval JevReport.pkl -p run=<part run dir> -p revision=<revision>
///
/// prints `starter` and `solved` (the two traces, each holding every earlier
/// revision's turns), `prose`, and `ids`, the Questions asked of the revision,
/// whose collected files the lesson reveals.
module JevReport

import "pkl:json"

import "../../../src/jev/pkl/Question.pkl"
import "../../../jev-playwright/pkl/Experiment.pkl"
import "../../../jev-playwright/report-expected.pcf" as contract
import "../rails-probes/traces/AcpTrace.pkl"

/// The part's run directory.
run: String = read("prop:run")
/// The revision this lesson reviews.
revision: String = read("prop:revision")

local parser = new json.Parser { useMapping = true }
local function load(file: String): Mapping = parser.parse(read("\(run)/\(file)")) as Mapping

local contractDigest = read("../../../jev-playwright/report-expected.pcf").text.sha256
/// The revisions in lesson order, up to and including this lesson's.
local chapter: List<String> = contract.revisions.keys.toList().sortBy((r) -> contract.revisions[r].lesson.order)
local told: Experiment.Revision = contract.revisions.getOrNull(revision)
  ?? throw("no revision \(revision) in report-expected.pcf")
local turns: List<String> = chapter.take(chapter.indexOf(revision) + 1)
/// The Questions asked of a revision, in contract order.
local function idsOf(rev: String): List<String> = contract.questions.keys.toList().filter((id) -> contract.questions[id].revision == rev)
ids: List<String> = idsOf(revision)
local function question(id: String): Experiment.Asked = contract.questions[id]

local function state(id: String): Mapping = load("questions/\(id)/state.json")["state"]
/// Who answered, and when: the collector's record.
local function answer(id: String): Mapping = load("questions/\(id)/answer.json")
local runId: String = answer(ids.first)["runId"]
local function outcome(id: String): Question.Outcome = Question.outcome(question(id), answer(id)["probability"] as Number)
local function policy(rev: String): String = state(idsOf(rev).first)["authorizationPolicy"]

/// A canned answer is never presented as a Jev judgement (CIT-320 `backend-labelled`).
local function mock(id: String): Boolean = answer(id)["backend"] == "mock"
local reviewer: String = if (turns.flatMap((r) -> idsOf(r)).every((id) -> mock(id))) "mock" else "jev"
local function scorer(id: String): String = if (mock(id)) "Mock" else "Jev"
local function mockNote(id: String): String = if (mock(id)) " A canned mock answer, not a Jev judgement." else ""

local function percent(x: Number): String =
  let (p = x * 100) if (p.round() == p) p.round().toInt().toString() else p.toString()
local function pct(id: String): String = "\(percent(answer(id)["probability"]))%"
local function range(id: String): String = "\(percent(question(id).expected.min))–\(percent(question(id).expected.max))%"
local function exchange(id: String): String =
  let (http = state(id)["http"])
    "\(http["request"]["method"]) \(http["request"]["path"]) as \(http["request"]["actor"]): \(http["response"]["status"])"

/// What the answerer said, against the range a sound policy answers in. Either outcome is data.
local function answerText(id: String): String =
  "\(scorer(id)) answered \(pct(id)); expected \(range(id)): \(outcome(id)).\(mockNote(id))"

/// Compare each repeated request to the prerequisite observation it follows.
local function comparison(id: String): String =
  if (question(id).dependencies.isEmpty) "" else
    let (prior = question(id).dependencies.first)
    let (before = state(prior)["http"]["response"]["status"])
    let (after = state(id)["http"]["response"]["status"])
      " Same request as \(prior): HTTP \(before) → \(after). \(if (before == after) "Owner access is preserved." else "The owner check denies the previously exposed document.")"

local function change(rev: String): String =
  if (rev == chapter.first) "" else
    let (prior = chapter[chapter.indexOf(rev) - 1])
    "\n\nWhy this change: the baseline returned Bob's private document to Alice (\(exchange(idsOf(prior).first))). Signing in alone did not enforce ownership.\nReplace the baseline policy:\n\(policy(prior))\nwith the owner check above. Review the same Alice and Bob requests again: does it close the leak while preserving the owner's access?"

/// The rows the lens opens: the answer, what it was asked, and the evidence it judged.
local function rows(id: String): Listing<AcpTrace.Row> = new {
  new {
    role = "observation"
    uri = "questions/\(id)/response.json"
    detail = "\(answerText(id))\(comparison(id)) Run \(runId); model \(answer(id)["model"])."
  }
  new {
    role = "axiom"
    uri = "report-expected.pcf"
    detail = "\(question(id).judge.instructions)\nExpected \(range(id)); contract \(contractDigest)"
  }
  new {
    role = "observation"
    uri = "questions/\(id)/state.json"
    revision = question(id).revision
    detail = "\(exchange(id))\n\(new JsonRenderer { indent = "  " }.renderValue(state(id)["http"]["response"]["body"]).trimEnd())"
  }
  new {
    role = "observation"
    uri = "questions/\(id)/request.json"
    detail = "What \(if (mock(id)) "the mock backend" else "Jev") was sent: this state and the question, without its expected range."
  }
  for (prior in question(id).dependencies) {
    new {
      role = "observation"
      uri = "questions/\(prior)/state.json"
      revision = question(prior).revision
      detail = "Baseline: \(exchange(prior))\n\(policy(question(prior).revision))"
    }
  }
}

local function probe(id: String): AcpTrace.Probe = new {
  action = exchange(id)
  question = question(id).ask
  diagnostic {
    severity = if (outcome(id) == "in-range") "info" else "error"
    code = id
    message = "\(code): \(answerText(id))\(comparison(id))"
    evaluationId = "\(runId):\(contractDigest):\(id)"
    related = rows(id)
  }
}

/// Epoch milliseconds (after 1970) as `Date.prototype.toISOString` writes them (UTC).
local function iso(ms: Int): String =
  let (days = ms ~/ 86400000)
  let (rest = ms - days * 86400000)
  // Howard Hinnant's civil_from_days.
  let (z = days + 719468)
  let (era = z ~/ 146097)
  let (doe = z - era * 146097)
  let (yoe = (doe - doe ~/ 1460 + doe ~/ 36524 - doe ~/ 146096) ~/ 365)
  let (doy = doe - (365 * yoe + yoe ~/ 4 - yoe ~/ 100))
  let (mp = (5 * doy + 2) ~/ 153)
  let (d = doy - (153 * mp + 2) ~/ 5 + 1)
  let (m = if (mp < 10) mp + 3 else mp - 9)
  let (y = yoe + era * 400 + (if (m <= 2) 1 else 0))
  let (pad = (n: Int, w: Int) -> n.toString().padStart(w, "0"))
    "\(pad.apply(y, 4))-\(pad.apply(m, 2))-\(pad.apply(d, 2))T\(pad.apply(rest ~/ 3600000, 2)):\(pad.apply(rest ~/ 60000 % 60, 2)):\(pad.apply(rest ~/ 1000 % 60, 2)).\(pad.apply(rest % 1000, 3))Z"

local function finishedAt(rev: String): List<Int> = idsOf(rev).map((id) -> answer(id)["finishedAt"] as Int)

/// One revision's turn: its commit sent as a prompt, then the reviewer's reply.
/// The turn's number is its JSON-RPC id, so a reply answers its own prompt.
local function ask(rev: String): AcpTrace.ClientFrame = new {
  action = "send prompt"
  envelope {
    id = chapter.indexOf(rev) + 1
    params {
      sessionId = runId
      prompt { new { text = "\(contract.revisions[rev].subject)\n\nThe document route's authorization policy, as the run recorded it:\n\(policy(rev))\(change(rev))" } }
    }
  }
  provenance {
    recordingId = "\(runId)#\(rev)"
    capturedAt = iso(finishedAt(rev).min)
    scripted = "The subject question is authored in report-expected.pcf; the body is the policy the run recorded at this revision."
  }
}

local function reply(rev: String): AcpTrace.AgentFrame = new {
  action = "reply with finding"
  speaker = reviewer
  envelope {
    id = chapter.indexOf(rev) + 1
    result {
      _meta {
        diagnostic {
          severity = if (idsOf(rev).every((id) -> outcome(id) == "in-range")) "info" else "error"
          code = "jev.\(rev)"
          message = "\(code): \(idsOf(rev).map((id) -> "\(question(id).ask) \(answerText(id))").join(" "))"
          subject {
            role = "fact"
            uri = "questions/\(idsOf(rev).first)/state.json#/state/authorizationPolicy"
            revision = rev
            detail = policy(rev)
          }
          related { for (id in idsOf(rev)) { for (row in rows(id)) { row } } }
          evaluationId = "\(runId):\(contractDigest):\(rev)"
        }
        probes { for (id in idsOf(rev)) { probe(id) } }
      }
    }
  }
  provenance {
    recordingId = "\(runId)#\(rev)/reply"
    capturedAt = iso(finishedAt(rev).max)
    scripted = "ACP framing authored; every answer, policy and exchange is read from the run\(if (reviewer == "mock") ", whose answers are canned mock answers, not Jev judgements" else "")."
  }
}

starter: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames {
    for (rev in turns.dropLast(1)) { ask(rev); reply(rev) }
    ask(revision)
  }
  nextTurn {
    actor = "agent"
    speaker = reviewer
    action = "review the \(revision) revision"
  }
}

solved: AcpTrace.Trace = new {
  scenario = "cit294-review-v1"
  frames {
    for (rev in turns) { ask(rev); reply(rev) }
  }
  nextTurn = null
}

local bridge =
  """
  import AcpTraceBridge from '../../../../../components/AcpTraceBridge';

  <AcpTraceBridge client:load traceFile="/acp-trace.json" scenario="cit294-review-v1" />

  """

output {
  value = new Mapping {
    ["ids"] = ids
    ["starter"] = AcpTrace.renderer.renderDocument(starter)
    ["solved"] = AcpTrace.renderer.renderDocument(solved)
    ["prose"] = "\(bridge)\n\(told.lesson.prose)\n"
  }
  renderer = new JsonRenderer {}
}
