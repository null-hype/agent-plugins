/// Case-owned declared expectations for each of CIT-294's four runs. Kept
/// separate from the independent Observation (observations/*.json, produced
/// by the live run) and from Reconcile's check function, per the
/// declared/observed/checked split CIT-265 uses throughout (see
/// src/noteexpand's Claims.pkl for the pattern this follows). Written before
/// reading the observations, not fitted to them afterward.
///
/// `expectedBytesHex`/`returnedByteCountExpected` are the pinned, known-good
/// values Reconcile checks the observation's raw bytes against directly --
/// not a boolean the live run self-reports. `variantErrorClassExpected`/
/// `variantErrorContains` pin the *specific* refusal a blocked arm must
/// produce, not merely that something failed. Added in response to CIT-297:
/// see Reconcile.pkl for how each is used.
///
/// `expectedSourceSha256`/`expectedRailsLoadDefaults`/`expectedVariantProcessor`
/// are pinned for every arm (not just one), so a blocked arm can't silently
/// run against a different input or a different runtime config than its
/// unblocked counterpart -- added per CIT-303's review of CIT-297.
module cit294.claims

class Claim {
  arm: String
  blockUntrustedEnv: String?
  contentTypeRetained: Boolean
  loaderExpected: String?
  variantSucceedsExpected: Boolean
  discloseExpected: Boolean
  /// Whether the independent strace evidence must show the dummy canary
  /// file opened by this arm. True only for the unblocked MAT canary --
  /// every other arm (including the blocked MAT canary) must show zero.
  independentReadExpected: Boolean
  /// Required when `variantSucceedsExpected == false`: the specific
  /// exception class the real variant call must raise. A generic
  /// `RuntimeError` or similar must not satisfy this.
  variantErrorClassExpected: String?
  /// Required when `variantSucceedsExpected == false`: a substring the
  /// variant's own error message must contain, naming the actual refusal
  /// (e.g. "blocked") rather than an unrelated failure.
  variantErrorContains: String?
  /// The exact byte count the returned variant's raw pixels must have.
  /// Null only for the blocked MAT arm, where no bytes are returned at all.
  returnedByteCountExpected: Int?
  /// The exact hex-encoded bytes the returned variant's raw pixels must
  /// equal -- the canary's dummy-file secret for the unblocked MAT arm, the
  /// control image's own known pixel data for the PNG arms. Null only for
  /// the blocked MAT arm.
  expectedBytesHex: String?
  /// The pinned sha256 of the source file this arm is required to upload
  /// (`canary.mat` for both MAT arms, `control.png` for both PNG arms).
  /// Added per CIT-303: previously only the unblocked MAT arm's runtime
  /// config was checked anywhere, and no arm's source hash was checked
  /// against a pinned value at all -- a blocked arm could silently run
  /// against a different file (or a different Rails/libvips config) than
  /// its unblocked counterpart and still pass. Pinning the same value for
  /// both arms of a pair makes this a same-input, same-config comparison,
  /// not just two independent assertions.
  expectedSourceSha256: String
  /// The pinned `config.load_defaults` every arm must have run with.
  expectedRailsLoadDefaults: String
  /// The pinned `active_storage.variant_processor` every arm must have run
  /// with.
  expectedVariantProcessor: String
}

/// sha256 of canary.mat and control.png as baked into the pinned
/// `cit294:live` image (see observations/*.json's independent_source_sha256
/// -- these are the same bytes `craft_mat_canary.py`/the Dockerfile produce
/// every build, so pinning them here is the same kind of known-good literal
/// `expectedBytesHex` above already uses, not a value fitted after the
/// fact).
local matSourceSha256 = "f1c62ebc5fb7ab50655d505f3c30498713cdef232d3bdef585935024bd007fcc"
local pngSourceSha256 = "25d910af6444dbe465a02584c6bcebdd8387e27a45190aedf0c92fea788c82ce"
local railsLoadDefaults = "7.0"
local variantProcessor = "vips"

matUnblocked: Claim = new {
  arm = "mat"
  blockUntrustedEnv = null
  contentTypeRetained = true
  loaderExpected = "matload"
  variantSucceedsExpected = true
  discloseExpected = true
  independentReadExpected = true
  variantErrorClassExpected = null
  variantErrorContains = null
  returnedByteCountExpected = 32
  expectedBytesHex = "4b5232532d43414e4152592d4349543239342d30313233343536373839616263"
  expectedSourceSha256 = matSourceSha256
  expectedRailsLoadDefaults = railsLoadDefaults
  expectedVariantProcessor = variantProcessor
}

matBlocked: Claim = new {
  arm = "mat"
  blockUntrustedEnv = "1"
  contentTypeRetained = true
  loaderExpected = null
  variantSucceedsExpected = false
  discloseExpected = false
  independentReadExpected = false
  variantErrorClassExpected = "Vips::Error"
  variantErrorContains = "blocked"
  returnedByteCountExpected = null
  expectedBytesHex = null
  expectedSourceSha256 = matSourceSha256
  expectedRailsLoadDefaults = railsLoadDefaults
  expectedVariantProcessor = variantProcessor
}

pngUnblocked: Claim = new {
  arm = "png"
  blockUntrustedEnv = null
  contentTypeRetained = true
  loaderExpected = "pngload"
  variantSucceedsExpected = true
  discloseExpected = false
  independentReadExpected = false
  variantErrorClassExpected = null
  variantErrorContains = null
  returnedByteCountExpected = 4
  expectedBytesHex = "00000000"
  expectedSourceSha256 = pngSourceSha256
  expectedRailsLoadDefaults = railsLoadDefaults
  expectedVariantProcessor = variantProcessor
}

pngBlocked: Claim = (pngUnblocked) { blockUntrustedEnv = "1" }
