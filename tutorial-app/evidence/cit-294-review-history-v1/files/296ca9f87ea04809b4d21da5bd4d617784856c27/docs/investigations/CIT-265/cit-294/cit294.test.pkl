amends "pkl:test"

import "pkl:json"
import "Claims.pkl" as Claims
import "Reconcile.pkl" as Reconcile
import "Observation.pkl" as Observation

local function load(name: String): Observation.Observed =
  Observation.fromJson(read("observations/\(name).json").text)

local matUnblocked = load("mat-unblocked")
local matBlocked = load("mat-blocked")
local pngUnblocked = load("png-unblocked")
local pngBlocked = load("png-blocked")

facts {
  ["unblocked MAT canary: content type retained as declared, despite the real bytes being the MAT/HDF5 payload"] {
    matUnblocked.declared_content_type == "image/png"
    matUnblocked.stored_content_type == "image/png"
  }
  ["unblocked MAT canary: matload is the loader libvips actually selected"] {
    matUnblocked.loader_selected == "matload"
  }
  ["unblocked MAT canary: the dummy file's exact bytes and count are recoverable from the returned variant -- not just a trusted boolean"] {
    matUnblocked.returned_byte_count == 32
    matUnblocked.returned_bytes_hex == "4b5232532d43414e4152592d4349543239342d30313233343536373839616263"
    matUnblocked.matches_dummy_file == true
  }
  ["unblocked MAT canary: independently (via strace, outside the Ruby process) confirmed open of the dummy file"] {
    matUnblocked.independent_dummy_file_openat_count > 0
  }
  ["unblocked MAT canary: the retained trace text itself -- not just the derived count -- actually shows the dummy file's openat, so deleting it is detectable (CIT-303)"] {
    matUnblocked.independent_trace_text.contains("dummy-canary.txt")
    matUnblocked.independent_trace_text.contains("openat(")
  }
  ["blocked MAT canary: no loader ran and the *actual variant call* raised the specific block error -- a generic crash does not satisfy this"] {
    matBlocked.loader_selected == null
    matBlocked.variant_succeeded == false
    matBlocked.variant_error_class == "Vips::Error"
    (matBlocked.variant_error ?? "").contains("blocked")
  }
  ["blocked MAT canary: no disclosure field claims a match, and no returned bytes are present at all (refusal, not a silent empty read)"] {
    matBlocked.matches_dummy_file != true
    matBlocked.returned_bytes_hex == null
  }
  ["blocked MAT canary: independently (via strace) confirmed the dummy file was never opened -- not merely that the script didn't report it"] {
    matBlocked.independent_dummy_file_openat_count == 0
  }
  ["blocked MAT canary: the retained trace text itself contains no dummy-canary.txt openat line -- not just a zero in a separately derived count (CIT-303)"] {
    !matBlocked.independent_trace_text.contains("dummy-canary.txt")
  }
  ["PNG control processes normally whether or not untrusted loaders are blocked, with byte-exact pixel data in both cases"] {
    pngUnblocked.variant_succeeded == true
    pngBlocked.variant_succeeded == true
    pngUnblocked.loader_selected == "pngload"
    pngBlocked.loader_selected == "pngload"
    pngUnblocked.returned_bytes_hex == "00000000"
    pngBlocked.returned_bytes_hex == "00000000"
    pngUnblocked.independent_dummy_file_openat_count == 0
    pngBlocked.independent_dummy_file_openat_count == 0
  }
  ["all four arms ran against the identical pinned image -- the verdict is about one configuration, not a drifting rebuild"] {
    matUnblocked.independent_image_id == matBlocked.independent_image_id
    matBlocked.independent_image_id == pngUnblocked.independent_image_id
    pngUnblocked.independent_image_id == pngBlocked.independent_image_id
  }
  ["the runtime configuration each verdict is bound to is recorded, not assumed -- checked for every arm, not just one (CIT-303: the prior version of this fact checked only the unblocked MAT arm, so a drifted blocked-arm config would have passed unnoticed)"] {
    matUnblocked.independent_rails_load_defaults == "7.0"
    matUnblocked.independent_active_storage_variant_processor == "vips"
    matBlocked.independent_rails_load_defaults == "7.0"
    matBlocked.independent_active_storage_variant_processor == "vips"
    pngUnblocked.independent_rails_load_defaults == "7.0"
    pngUnblocked.independent_active_storage_variant_processor == "vips"
    pngBlocked.independent_rails_load_defaults == "7.0"
    pngBlocked.independent_active_storage_variant_processor == "vips"
  }
  ["each blocked/unblocked pair uploaded the identical source file -- the blocking comparison is about the same input, not two different files that happen to both be named canary.mat/control.png (CIT-303)"] {
    matUnblocked.independent_source_sha256 == matBlocked.independent_source_sha256
    pngUnblocked.independent_source_sha256 == pngBlocked.independent_source_sha256
  }
  ["reconciling each observation against its declared claim raises no flags"] {
    Reconcile.check(Claims.matUnblocked, matUnblocked).isEmpty
    Reconcile.check(Claims.matBlocked, matBlocked).isEmpty
    Reconcile.check(Claims.pngUnblocked, pngUnblocked).isEmpty
    Reconcile.check(Claims.pngBlocked, pngBlocked).isEmpty
  }
  ["a claim that disagrees with reality is exactly what gets flagged"] {
    Reconcile.check((Claims.matUnblocked) { discloseExpected = false }, matUnblocked)
      .any((f) -> f.kind == "unexpected-disclosure")
    Reconcile.check((Claims.matBlocked) { variantSucceedsExpected = true }, matBlocked)
      .any((f) -> f.kind == "variant-outcome-mismatch")
  }
  ["negative control: a generic crash does not pass as a successful block, even with the blocking env var and no loader selected"] {
    Reconcile.check(Claims.matBlocked, (matBlocked) {
      variant_error_class = "RuntimeError"
      variant_error = "disk full"
    }).any((f) -> f.kind == "generic-crash-not-specific-block")
  }
  ["negative control: the right error class with an unrelated message does not pass either"] {
    Reconcile.check(Claims.matBlocked, (matBlocked) {
      variant_error = "jpegload: unsupported colour profile"
    }).any((f) -> f.kind == "block-reason-not-confirmed")
  }
  ["negative control: emptying the returned bytes/count is caught even though matches_dummy_file still says true"] {
    local tampered = (matUnblocked) { returned_bytes_hex = ""; returned_byte_count = 0 }
    local flags = Reconcile.check(Claims.matUnblocked, tampered)
    flags.any((f) -> f.kind == "byte-count-mismatch")
    flags.any((f) -> f.kind == "returned-bytes-mismatch")
    flags.any((f) -> f.kind == "self-report-inconsistent")
  }
  ["negative control: corrupting the blocked PNG control's pixels is caught, independent of the MAT canary's own checks"] {
    Reconcile.check(Claims.pngBlocked, (pngBlocked) { returned_bytes_hex = "ffffffff" })
      .any((f) -> f.kind == "returned-bytes-mismatch")
  }
  ["negative control: zeroing the convenience int while leaving the retained trace alone is caught as a self-inconsistent observation, not as a missing read -- CIT-303 found the prior version of this control mutated only the derived count, which does not reproduce an actually deleted/falsified trace"] {
    Reconcile.check(Claims.matUnblocked, (matUnblocked) { independent_dummy_file_openat_count = 0 })
      .any((f) -> f.kind == "trace-count-mismatch")
  }
  ["negative control: inflating the convenience int while leaving the retained trace alone is caught the same way for the blocked arm"] {
    Reconcile.check(Claims.matBlocked, (matBlocked) { independent_dummy_file_openat_count = 1 })
      .any((f) -> f.kind == "trace-count-mismatch")
  }
  ["negative control: actually deleting the retained trace text for the unblocked MAT arm is caught -- this is the exact CIT-303 finding (deleting canary-reads.txt, not just zeroing a derived count, previously still passed every assertion)"] {
    Reconcile.check(Claims.matUnblocked, (matUnblocked) { independent_trace_text = "" })
      .any((f) -> f.kind == "independent-read-mismatch")
  }
  ["negative control: forging a dummy-file openat line into the blocked arm's retained trace text is caught -- the other half of the same CIT-303 finding"] {
    Reconcile.check(Claims.matBlocked, (matBlocked) {
      independent_trace_text = "[pid    99] openat(AT_FDCWD</app>, \"/work/dummy-canary.txt\", O_RDONLY) = 9</work/dummy-canary.txt>"
    }).any((f) -> f.kind == "independent-read-mismatch")
  }
  ["negative control: the blocked MAT arm silently running against a different (but validly-shaped) source file is caught -- CIT-303 found the source hash was only shape-checked, never compared to a pinned value, on any arm"] {
    Reconcile.check(Claims.matBlocked, (matBlocked) {
      independent_source_sha256 = pngUnblocked.independent_source_sha256
    }).any((f) -> f.kind == "source-identity-mismatch")
  }
  ["negative control: the blocked MAT arm silently running under a different Rails/variant-processor configuration is caught -- CIT-303 found the configuration fact covered only the unblocked arm, so a drifted blocked-arm config passed with empty diagnostics"] {
    local flags = Reconcile.check(Claims.matBlocked, (matBlocked) {
      independent_rails_load_defaults = "6.1"
      independent_active_storage_variant_processor = "mini_magick"
    })
    flags.filter((f) -> f.kind == "runtime-config-mismatch").length == 2
  }
}

examples {
  ["mat-unblocked"] { matUnblocked.loader_selected; matUnblocked.matches_dummy_file; matUnblocked.recovered_text; matUnblocked.independent_dummy_file_openat_count }
  ["mat-blocked"] { matBlocked.loader_selected; matBlocked.variant_succeeded; matBlocked.variant_error_class; matBlocked.variant_error; matBlocked.independent_dummy_file_openat_count }
  ["png-unblocked"] { pngUnblocked.loader_selected; pngUnblocked.variant_succeeded; pngUnblocked.returned_bytes_hex }
  ["png-blocked"] { pngBlocked.loader_selected; pngBlocked.variant_succeeded; pngBlocked.returned_bytes_hex }
}
