/// Typed, explicitly modelled claims for the part-5 S1 → S2 replay.
/// Provenance on each wrapper applies to every nested field, including IDs,
/// paths, sizes and dump contents. No value in this module is observed restic output.
module resticLessonEvidence

import "../../../tk-evidence-exporter/pkl/Evidence.pkl"

class ModelledSnapshot {
  provenance: "modelled" = "modelled"
  state: "S1"|"S2"
  repositoryId: String
  value: Evidence.SnapshotRef
}

class ModelledDiff {
  provenance: "modelled" = "modelled"
  value: Evidence.DiffEntry
}

/// A path → contents dump with its snapshot and file-tree identity.
class FileDump {
  provenance: "modelled" = "modelled"
  archivePath: String
  entry: Evidence.FileTreeEntry
  contents: String
}

provenance: "modelled" = "modelled"
snapshots: Listing<ModelledSnapshot>
diff: Listing<ModelledDiff>
dumps: Listing<FileDump>
