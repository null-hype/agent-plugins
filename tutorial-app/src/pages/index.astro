---
import TidelandsHome from '../components/TidelandsHome';
const title = 'Richard Anthony Massey | Software engineer, Sydney';
const description = 'Richard Anthony Massey, software engineer in Sydney. See what an agent handoff left out and how to trace it back to the source.';
const canonical = new URL('/', Astro.site ?? 'https://www.tidelands.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body style="margin: 0">
    <TidelandsHome client:load />
  </body>
</html>
