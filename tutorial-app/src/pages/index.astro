---
import { PortfolioLanding } from '../components/PortfolioLanding';
const title = 'Richard Anthony — verification infrastructure for agent-produced software';
const description = 'Capture the world, run the check, preserve the evidence. Richard Anthony builds verification infrastructure and developer tools. Based in Sydney; available for senior engineering roles and selected consulting.';
const canonical = new URL('/', Astro.site ?? 'https://www.tidelands.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/portfolio-social.png', canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Richard Anthony / null-hype. Verification infrastructure for agent-produced software. A log of evidence." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <PortfolioLanding />
  </body>
</html>

<style is:global>
  body { margin: 0; background: #f4f0e7; }
</style>
