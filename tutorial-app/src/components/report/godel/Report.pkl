/// One object, three jobs. Before a run it is a preregistration: each question
/// carries the prediction, registered in Pass. During a run it is Jev's
/// payload: `requests` is what systemOne is sent. After a run, with Jev's
/// answers added, it is the graded report.
///
/// Controls are graded against truth, claims against Jev: a control's status
/// says whether Jev got a known answer right; a claim's says whether Jev
/// answered as predicted. A claim is only read when every control it requires
/// has held.
module Report

/// Jev's model, and the spread of its answers to one question about one fixed
/// state (measured on worlds' delivery steps, not on these questions).
model: String = "jev-1.14.0"
noise: Float = 0.07

/// What Jev is asked about every question's state.
instructions: String = "How likely is it that the sentence in the state is true?"

class Question {
  /// The paragraph.
  text: String(!isEmpty)
  /// The state Jev is asked about; by default, the paragraph as the sentence.
  state: Mapping<String, String> = new { ["sentence"] = text }
  /// Registered before the run: what Jev is predicted to answer.
  prediction: Float(isBetween(0, 1))
  /// Set on controls only: the known answer.
  truth: Float(isBetween(0, 1))?
  /// The questions that have to hold before this one can be read.
  requires: Listing<String>
  /// Jev's answers; empty until the run.
  answers: Listing<Float(isBetween(0, 1))>

  hidden fixed isControl: Boolean = truth != null
  hidden fixed mean: Float? = if (answers.isEmpty) null else answers.toList().fold(0.0, (a, x) -> a + x) / answers.length
  /// The prediction against Jev's mean.
  hidden fixed brier: Float? = if (mean == null) null else (prediction - mean!!) ** 2
  /// Jev's mean against the known answer, for controls.
  hidden fixed jevError: Float? = if (mean == null || truth == null) null else (truth!! - mean!!).abs
}

/// Where the predictions are registered and when, as Pass gives it.
class Registration {
  item: String(!isEmpty)
  /// The judge's role on the item: one that cannot change it.
  role: String
  /// When Pass last saw the item change, UTC.
  written: String
}

registration: Registration
/// When the run that produced the answers started, UTC; null before a run.
runStarted: String?

title: String
questions: Mapping<String, Question>

/// Written after the run, or by a role that could have changed it.
hidden fixed tampered: Boolean = registration.role != "Viewer" || (runStarted != null && registration.written > runStarted!!)

hidden fixed statuses: Mapping<String, String> = new {
  for (id, q in questions) {
    [id] = status(q)
  }
}

local function graded(q: Question): String =
  if (q.isControl) (if (q.jevError!! < noise) "Held" else "Missed")
  else (if ((q.prediction - q.mean!!).abs < noise) "Held" else "Missed")

local function status(q: Question): String =
  if (tampered) "Tampered"
  else if (q.answers.isEmpty) "Not run"
  else if (q.requires.toList().any((r) -> questions[r].answers.isEmpty || graded(questions[r]) != "Held")) "Inconclusive"
  else graded(q)

/// Mean Brier over the claims that were read: how well the predictions matched Jev.
hidden fixed brier: Float? =
  let (scored = questions.toMap().entries
    .filter((e) -> !e.value.isControl && (statuses[e.key] == "Held" || statuses[e.key] == "Missed"))
    .map((e) -> e.value.brier!!))
    if (scored.isEmpty) null else scored.fold(0.0, (a, x) -> a + x) / scored.length

/// What systemOne is sent, one request per question.
hidden fixed requests: Mapping<String, Dynamic> = new {
  for (id, q in questions) {
    [id] {
      state = q.state
      model = module.model
      questions { ["q"] { type = "noul"; instructions = module.instructions } }
    }
  }
}

output {
  value = new Dynamic {
    title = module.title
    tampered = module.tampered
    brier = module.brier
    paragraphs = new Listing {
      for (qid, q in questions) {
        new Dynamic {
          id = qid
          text = q.text
          control = q.isControl
          prediction = q.prediction
          requires = q.requires
          answers = q.answers
          mean = q.mean
          brier = q.brier
          status = statuses[qid]
        }
      }
    }
  }
  renderer = new JsonRenderer {}
}
