/// An article on tidelands.dev. Its words live here, not in Markdown, so the
/// page and what the article says about its own evidence come from one place.
/// `pkl eval <Article>.pkl` renders the JSON its page is built from.
module Article

/// Where it is published: /articles/<slug>/.
slug: String(matches(Regex("[a-z0-9-]+")))
title: String(!isEmpty)
/// The line under the title.
dek: String(!isEmpty)
/// UTC date, YYYY-MM-DD.
published: String(matches(Regex(#"\d{4}-\d{2}-\d{2}"#)))

/// A diagnostic drawn across every page of the article, on screen and in
/// print, like an editor's warning over the whole document: what the page
/// must not be taken for.
class Diagnostic {
  severity: "warning" = "warning"
  /// What raised it.
  source: String(!isEmpty)
  message: String(!isEmpty)
}
watermark: Diagnostic?

/// What the article rests on and how far each part has been checked, for a
/// reader, before they read it.
class Evidence {
  what: String(!isEmpty)
  /// Tested, Recorded, or Not yet.
  state: "Tested" | "Recorded" | "Not yet"
  note: String(!isEmpty)
}
evidence: Listing<Evidence>(!isEmpty)

class Code {
  text: String(!isEmpty)
}

/// A table: a header row, then rows of the same width.
class Table {
  columns: Listing<String>(!isEmpty)
  rows: Listing<Listing<String>>(toList().every((r) -> r.length == columns.length))
}

/// A paragraph, a block of code, or a table.
/// A heatmap: how well each row (a reason) fits each column (a thread), as
/// xeno scores it. A cell with nothing to compare is empty.
class Heatmap {
  fixed kind: "heatmap" = "heatmap"
  columns: Listing<String>(!isEmpty)
  rows: Listing<HeatmapRow>(toList().every((r) -> r.cells.length == columns.length))
}

class HeatmapRow {
  label: String
  cells: Listing<Score?>
}

/// One judgment: how well the thread fits the reason, and, when scored,
/// whether it achieved it. The band uses xeno's cut-offs.
class Score {
  fit: Float(isBetween(0, 1))
  achieved: Float(isBetween(0, 1))?
  fixed band: "supports" | "uncertain" | "rejects" =
    if (fit >= 0.8) "supports" else if (fit <= 0.2) "rejects" else "uncertain"
}

typealias Block = String | Code | Table | Heatmap

class Section {
  heading: String?
  blocks: Listing<Block>(!isEmpty)
}
sections: Listing<Section>(!isEmpty)

output {
  renderer = new JsonRenderer {}
}
