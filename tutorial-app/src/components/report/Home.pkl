/// The homepage report: one entry per published check, in the order they
/// should be read. To publish a check, add its completed claim to checks/ and
/// an entry here; its page is /checks/<id>/. `pkl eval Home.pkl` renders
/// report.json.
amends "Report.pkl"

import "pkl:json"

intro {
  "I break software for a living. Lately what I break most is an AI agent's claim that the job is done."
  "So I write down what should happen before an agent runs, then check what actually happened. This page is built from that written record, so every check is on it, including the ones that fail."
  "Sydney. Available for senior engineering roles and selected consulting."
}

title = "Checks"

questions {
  ["INF-6"] {
    text = "Preserve preregistered delivery claims across an observed World."
    href = "/checks/INF-6/"
    why = "An agent's work is judged against the predictions registered before its plan was approved, using a frozen snapshot of what happened rather than the repo as it is now. It fails if the judgement reads live state an agent could still change."
  }
}

// Each check's result is its completed claim's exit code: 1 green, 0 red.
run {
  for (id, _ in questions) {
    [id] = new Listing { if (claim(id).exit == 0) 1 else 0 }
  }
}

local function claim(id: String): Dynamic = new json.Parser {}.parse(read("checks/\(id).json")) as Dynamic
