---
import { Code } from 'astro:components';

interface Props {
  href: string;
}

const { href } = Astro.props;
const excerpt = '# "plain" (and "" before a drop) pass through unchanged.';
---

<figure>
  <Code code={excerpt} lang="python" theme="github-dark" wrap />
  <figcaption><a href={href}>Backend · session message 36, <code>transform.py</code></a></figcaption>
</figure>

<style>
  figure { margin: 1rem 0; }
  figure :global(pre) { padding: .75rem; border-inline-start: .2rem solid #f9d77c; }
  figcaption { font-size: .875rem; }
  a { color: #a0e9d5; text-underline-offset: .2em; }
</style>
