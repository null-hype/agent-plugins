/// CIT-395: the frame for one case (one Rails commit), as the editor would show
/// it to a reviewer before merging.
///
/// The hand-drawn sketch is a claim; this module is what the evidence supports.
/// It joins the case's files -- the commit message from git, Vale's alerts on
/// it, the Jev recordings, the snapshots -- and computes two things:
///
/// * `model`: the editor-agnostic `InvestigationModel` (see
///   `src/lib/investigationModel.ts`) that `InvestigationVault` renders. Every
///   marker and lens comes from a file in `cases/<hash>/`; a value with no
///   evidence behind it is shown as missing ("no recording for ..."), never
///   filled in. There is no score in this module and none in the story.
/// * `elements`: each element of the sketch marked proven, unproven or
///   contradicted against that same evidence, plus `undrawn`, what the
///   evidence shows and the sketch leaves out.
///
/// The case never reads its outcome. Whether the commit was later reverted or
/// named as a culprit is joined in only at the aggregate step, across cases.
///
/// Evaluate with `pkl eval -f json -p hash=fddf74bea9 Frame.pkl`;
/// `railsClaims.spec.ts` keeps `cases/<hash>/frame.json` current.
module Frame

import "pkl:json"
import "../../../../src/jev/pkl/Jev.pkl" as jev

hash: String = read("prop:hash")

local dir = "cases/\(hash)/"
local parser = new json.Parser {}
local message = read(dir + "commit.txt").text.trimEnd()
local lines = message.split("\n")
local alerts = (parser.parse(read(dir + "vale.json").text) as Listing).toList()
local recordings = (parser.parse(read(dir + "recordings.json").text) as Listing).toList()
local snapshots = (parser.parse(read(dir + "snapshots.json").text) as Listing).toList()
local sketch = (parser.parse(read(dir + "sketch.json").text) as Listing).toList()

/// The sentence a flagged line belongs to: its paragraph, re-joined. The
/// question is asked of the author's own words, not a rewrite of them.
local function sentenceAt(n: Int): String =
  let (i = n - 1)
  let (start = (lines.take(i).findLastIndexOrNull((l) -> l.trim().isEmpty) ?? -1) + 1)
  let (end = i + (lines.drop(i).findIndexOrNull((l) -> l.trim().isEmpty) ?? (lines.length - i)))
    lines.sublist(start, end).join(" ")

/// One claim question per Vale alert, as the Jev payload that would be sent.
/// Its digest is computed here, before any call, so a recording can only be
/// joined to the exact payload it answered.
class Claim {
  line: Int
  word: String
  check: String
  sentence: String
  payload: jev.JevRequest
  digest: String
}

claims: List<Claim> = alerts.map((a) ->
  let (said = sentenceAt(a.Line))
  let (req = new jev.JevRequest {
    state = new Mapping {
      ["repo"] = "rails/rails"
      ["commit"] = hash
      ["message"] = message
    }
    questions {
      ["claim"] {
        type = "noul"
        instructions = "The author of this commit wrote: \"\(said)\". Taking \"\(a.Match)\" literally, does the claim hold as written?"
      }
    }
  })
    new Claim {
      line = a.Line
      word = a.Match
      check = a.Check
      sentence = said
      payload = req
      digest = "sha256:" + new JsonRenderer {}.renderValue(req).sha256
    }
)

local function recordingFor(c: Claim) = recordings.findOrNull((r) -> r.digest == c.digest)
local function snapshotsFor(c: Claim) = snapshots.filter((s) -> s.digest == c.digest)

// ---- the editor model (shape of `InvestigationModel`) ----------------------

local commitDoc = "commit://rails/\(hash)/COMMIT_EDITMSG"
local function payloadDoc(c: Claim) = "jev://payload/\(c.digest)"
local function snapshotDoc(s) = "snapshot://\(s.id)/\(s.branch)"
local function at(line: Int) = new Dynamic { startLineNumber = line; startColumn = 1; endLineNumber = line; endColumn = 1 }

local function jevTitle(c: Claim) =
  let (r = recordingFor(c))
    if (r == null) "\(c.word) · Jev: no recording for \(c.digest.take(19))…"
    else "\(c.word) · Jev \(r.score) that it holds"

local commitDocument = new Dynamic {
  id = commitDoc
  uri { scheme = "commit"; authority = "rails"; path = "/\(hash)/COMMIT_EDITMSG" }
  text = message + "\n"
  trail = List("rails/rails", hash, "COMMIT_EDITMSG")
  markers = alerts.map((a) -> new Dynamic {
    line = a.Line
    column = a.Span[0]
    endColumn = a.Span[1] + 1
    message = "\(a.Message) (\(a.Check))"
    severity = "warning"
  })
  lenses = claims.flatMap((c) ->
    List(new Dynamic {
      line = c.line
      title = jevTitle(c)
      `open` { doc = payloadDoc(c); line = 1 }
    }) +
    let (snaps = snapshotsFor(c))
      if (snaps.isEmpty) List(new Dynamic { line = c.line; title = "\(c.word) · Peek: no snapshots" })
      else List(new Dynamic {
        line = c.line
        title = "\(c.word) · Peek: \(snaps.map((s) -> s.branch).join(" / "))"
        peek {
          anchor { lineNumber = c.line; column = 1 }
          locations = snaps.map((s) -> new Dynamic { doc = snapshotDoc(s); range = at(1) })
        }
      })
  )
  definitions = List()
}

local payloadDocuments = claims.map((c) -> new Dynamic {
  id = payloadDoc(c)
  uri { scheme = "jev"; authority = "payload"; path = "/" + c.digest }
  text = new JsonRenderer {}.renderValue(c.payload) + "\n"
  trail = List("rails/rails", hash, "jev payload", c.digest.take(19) + "…")
  markers = List()
  lenses = List(new Dynamic {
    line = 1
    title = if (recordingFor(c) == null) "pinned before the call · not sent yet" else "pinned before the call · recorded"
  })
  definitions = List()
})

model {
  documents = List(commitDocument) + payloadDocuments
  homeId = commitDoc
  start = List("rails/rails", hash, "COMMIT_EDITMSG")
}

// ---- the sketch, marked ----------------------------------------------------

local texts = sketch
  .filter((e) -> e.getPropertyOrNull("type") == "text")
  .toMap((e) -> e.id, (e) -> e.text)
local ids = sketch.map((e) -> e.getPropertyOrNull("id")).filterNonNull()
local drawnWords = List("always", "no longer")

class Element {
  claim: String
  status: "proven" | "unproven" | "contradicted"
  evidence: String
}

elements: Mapping<String, Element> = new {
  ["l1"] {
    claim = "the subject line is the author's"
    status = if (texts["l1"] == lines[0]) "proven" else "contradicted"
    evidence = "commit.txt line 1"
  }
  ["l3-l5"] {
    claim = "the highlighted lines are the author's sentence (re-wrapped)"
    status = if (List(texts["l3"], texts["l4"], texts["l5"]).join(" ") == sentenceAt(4)) "proven" else "contradicted"
    evidence = "commit.txt lines 3-4, joined"
  }
  ["h4"] {
    claim = "Vale flags \"always\""
    status = if (ids.contains("h4") && claims.any((c) -> c.word == "always")) "proven" else "contradicted"
    evidence = "vale.json"
  }
  ["h5"] {
    claim = "Vale flags \"no longer\""
    status = if (ids.contains("h5") && claims.any((c) -> c.word == "no longer")) "proven" else "contradicted"
    evidence = "vale.json"
  }
  ["p1"] {
    claim = texts["p1"]
    status = if (claims.any((c) -> texts["p1"] == "vale  \(c.check)  line \(c.line)  \"\(c.word)\"")) "proven" else "contradicted"
    evidence = "vale.json"
  }
  ["p2"] {
    claim = "the question \"\(texts["p2"])...\" comes from the flagged span"
    status = "unproven"
    evidence = "hand-written; Frame.pkl asks of the author's sentence instead, and no step rewrites it"
  }
  ["p4"] {
    claim = texts["p4"]
    status = if (claims.any((c) -> recordingFor(c) != null)) "proven" else "unproven"
    evidence = "recordings.json has \(recordings.length) recordings"
  }
  ["by/bn"] {
    claim = "Peek has a yes and a no state"
    status = if (snapshots.any((s) -> s.branch == "yes") && snapshots.any((s) -> s.branch == "no")) "proven" else "unproven"
    evidence = "snapshots.json has \(snapshots.length) snapshots; nothing in steps 1-8 produces them"
  }
  ["r3"] {
    claim = "the payload digest is \(texts["r3"].split("  ")[0].drop(8))"
    status =
      if (claims.any((c) -> c.digest.startsWith("sha256:9f2c"))) "proven"
      else "contradicted"
    evidence = "computed digests: \(claims.map((c) -> c.digest.take(19)).join(", "))"
  }
}

/// What the evidence shows that the sketch does not draw.
undrawn: List<String> = claims
  .filter((c) -> !drawnWords.contains(c.word))
  .map((c) -> "Vale also flags \"\(c.word)\" on line \(c.line)") +
  (if (claims.filter((c) -> drawnWords.contains(c.word)).map((c) -> c.line).toSet().length == 1)
    List("\"always\" and \"no longer\" are on one line of the real message; the sketch draws two")
  else List())

output {
  renderer = new JsonRenderer {}
}
