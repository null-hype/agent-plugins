/// CIT-397: the rendering facts for one case. `rendered.json` is what the
/// browser showed when the story's play run finished (written by
/// `tests/rails-claims/rendered.spec.ts`); the facts check it against the
/// case's evidence and the frame Frame.pkl computed from it. A pass says the
/// reviewer saw the frame, not that any claim holds.
///
///   pkl test -p hash=fddf74bea9 Rendered.test.pkl
amends "pkl:test"

import "pkl:json"

local hash = read("prop:hash")
local dir = "cases/\(hash)/"
local parser = new json.Parser {}
local function load(file: String) = parser.parse(read(dir + file).text)

local message = read(dir + "commit.txt").text
local alerts = (load("vale.json") as Listing).toList()
local recordings = (load("recordings.json") as Listing).toList()
local frame = load("frame.json") as Dynamic
local rendered = load("rendered.json") as Dynamic

local documents = (frame.model.documents as Listing).toList()
local commitDoc = documents.first
local claims = (frame.claims as Listing).toList()
local shown = rendered.commit
local opened = rendered.payload
local lensTitles = (shown.lenses as Listing).toList()

facts {
  ["the editor shows the author's commit message"] {
    shown.text == message
  }
  ["every Vale alert is a marker where Vale put it, and nothing else is"] {
    (shown.markers as Listing).toList().map((m) -> List(m.line, m.column, m.endColumn)).toSet()
      == alerts.map((a) -> List(a.Line, a.Span[0], a.Span[1] + 1)).toSet()
    shown.squiggles == alerts.length
  }
  ["the lenses shown are the lenses the frame computed"] {
    lensTitles.sort() == (commitDoc.lenses as Listing).toList().map((l) -> l.title).sort()
  }
  ["the Jev lens opens the payload its digest names"] {
    let (always = claims.find((c) -> c.word == "always"))
      opened.uri == "jev://payload/\(always.digest)"
        && opened.text == documents.find((d) -> d.id == opened.uri).text
  }
  ["no score is shown without a recording"] {
    recordings.isEmpty.implies(!lensTitles.any((t) -> t.matches(Regex(#".*Jev \d.*"#))))
  }
}
