// CIT-399: each claim's pinned payload, written out for `jev` as
// <digest>/payload.json (jev sends only its `state`) and
// <digest>/questions.json, so ask.sh can send exactly what Frame.pkl pinned.
//
//   pkl eval -m payloads -p hash=fddf74bea9 Payloads.pkl
import "Frame.pkl"

local json = new JsonRenderer {}

output {
  files {
    for (c in Frame.claims) {
      ["\(c.digest.drop(7))/payload.json"] { value = c.payload; renderer = json }
      ["\(c.digest.drop(7))/questions.json"] { value = c.payload.questions; renderer = json }
    }
  }
}
