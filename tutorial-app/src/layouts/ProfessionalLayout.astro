---
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://www.tidelands.dev');
const image = new URL('/professional-preview.png', canonical.origin);
const imageAlt = 'Richard Anthony — Senior software & security engineer. AI infrastructure, security and developer tooling. Sydney.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Richard Anthony" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body style="margin: 0"><slot /></body>
</html>
