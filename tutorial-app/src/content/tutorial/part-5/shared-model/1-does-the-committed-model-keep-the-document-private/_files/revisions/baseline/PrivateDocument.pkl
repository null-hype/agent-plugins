/// Who can read Bob's private document, as chances. A reader who does not own
/// it must be held to even odds or less; anything above is a leak.
module PrivateDocument

typealias Chance = Number(isBetween(0, 1))
typealias NotOwner = Chance(this <= 0.5)

/// Signed in, not the owner.
aliceReads: NotOwner = 0.05

/// Signed in, the owner.
bobReads: Chance = 0.95
