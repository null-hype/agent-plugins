/// A Delta thread as `delta thread show --format summarize` renders it,
/// with each message's place in the full thread. Generated by pkl_thread.py.
module ThreadSchema

class Block {
  /// USER or AGENT, as the summary labels it.
  role: String
  /// The summary's text for this block, verbatim.
  text: String
}

class Message {
  number: Int
  role: "user" | "assistant"
  createdAt: String?
  /// Bytes of this message in the full thread.
  fullBytes: Int
  /// Summary block that carries this message, or null when it was dropped.
  block: Int?
}

id: String
name: String
/// Delta's narrative summary, and whether Delta considers it current.
summary: String?
summaryIsFresh: Boolean
blocks: Listing<Block>
messages: Listing<Message>
