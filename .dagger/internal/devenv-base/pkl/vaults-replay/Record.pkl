module VaultInventoryRecord
import "pkl:json"
import "Question.pkl" as inventory
import "../../../../../src/jev/pkl/Question.pkl"
import "../../../../../src/cve-2026-66066/questions/checker/Decode.pkl"

local raw = new json.Parser {}.parse(read(read("prop:capture")).text)
investigation: Question.Investigation = Decode.investigation(raw, inventory.question)
output {
  value = if (Question.validInvestigation(investigation)) investigation else throw("Invalid inventory record")
  renderer = new JsonRenderer { omitNullProperties = false }
}
