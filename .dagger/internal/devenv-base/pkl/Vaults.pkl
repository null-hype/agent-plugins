/// Declared inventory of Proton Pass vaults/items this repo depends on.
///
/// This is a decision, not a transcription of `pass-cli vault list` output
/// -- see the JIN-116 discussion. Only vaults/items actually referenced by
/// a `pass://` URI somewhere in this repo belong here.
///
/// The per-issue vaults (JIN-63, JIN-80, JIN-83, JIN-76, JIN-81, JIN-90)
/// have been consolidated: JIN-63 is retired, its infra-facing items
/// (restic, gh -> github.com) moved into a single shared "infra" vault
/// alongside tailscale, and its Linear-facing item (linear-release) moved
/// into "tidelands.dev" (formerly the vault named "linear.app", renamed --
/// see the JIN-63 vault-reorg fix). Vault names are no longer expected to
/// follow a JIN-<number> convention now that they're consolidated by
/// purpose rather than per-issue.
module vaults

class VaultSpec {
  name: String
  items: Listing<String>
}

declared: Listing<VaultSpec> = new {
  new VaultSpec {
    name = "infra"
    items {
      "restic"
      "github.com"
      "tailscale"
      "render.com"
      "cloudflare"
      "dagger.cloud"
    }
  }
  // "linear-release" and "claude" used to live here (see the header comment
  // above) but don't anymore -- confirmed against the real observed
  // inventory captured by test-global.yaml's vault-inventory gate (run
  // 35171754006): "claude" now lives in "anthropic.ai" below (its
  // consumers were already split -- continue-claude-session.env's own
  // CLAUDE_CODE_OAUTH_TOKEN line already pointed at anthropic.ai/claude,
  // only CLAUDE_SESSION_ID/CLAUDE_MAX_BUDGET_USD and
  // linear-triage-agent.env's two refs still pointed at the stale
  // location), and "linear-release" now lives in "jingling057" below.
  // Neither move is recorded anywhere else -- no commit in this repo made
  // it, so it happened directly in Proton Pass -- which is exactly the
  // kind of drift this fact/example pair exists to catch instead of
  // silently tolerating.
  new VaultSpec {
    name = "tidelands.dev"
    items {
      "agent.tidelands.dev"
      "pass-cli"
    }
  }
  // Not one of the per-issue/consolidated vaults above: every scenario's
  // own CLAUDE_CODE_OAUTH_TOKEN (test/**/.env) comes from here. Previously
  // undeclared entirely -- Vaults.test.pkl's envFiles list never scanned
  // any scenario .env, so a stale/renamed reference here had no check at
  // all, not even a JIN-<number>-style stale name.
  new VaultSpec {
    name = "anthropic.ai"
    items {
      "claude"
    }
  }
  // Where "linear-release" (see the "tidelands.dev" comment above) actually
  // lives now, confirmed against the same real observed inventory. The
  // vault is genuinely named "jingling057" in Proton Pass, not a typo for
  // an item name -- confirmed by the same inventory capture showing it as
  // a top-level vault with its own item list (which also happens to
  // contain a duplicate "agent.tidelands.dev" item; that duplicate isn't
  // declared here since every consumer of that item already resolves it
  // via the "tidelands.dev" vault above, and this file only declares
  // vault/item pairs actually referenced by a pass:// URI somewhere in
  // this repo).
  new VaultSpec {
    name = "jingling057"
    items {
      "linear-release"
    }
  }
  // JIN-90's dead-drop scenario (test/_global/jin-90-dead-drop.sh) plants,
  // reads, and deletes a freshly-titled note here on every run -- there's
  // no fixed item name to declare, unlike every other vault above, so
  // `items` stays empty and only the vault's own existence is checked.
  // Referenced by a hardcoded `--vault-name test` literal, not a `pass://`
  // URI, since it's addressed via pass-cli flags directly rather than an
  // env file. Lowercase "test", confirmed against the real observed vault
  // name in CI -- the CamelCase "Test" this used to say never existed as
  // such (a fabricated-looking guess this contract itself caught: the
  // observedVault() != null fact failed with an actual null for it).
  new VaultSpec {
    name = "test"
    items {}
  }
}
