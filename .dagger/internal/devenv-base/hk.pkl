amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    // Add linters here. Examples:
    // ["prettier"] = Builtins.prettier
    // ["eslint"] = Builtins.eslint
    // ["ruff"] = Builtins.ruff

    // Or define custom steps:
    // ["custom"] {
    //     glob = "**/*.py"
    //     check = "mypy {{ files }}"
    // }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = (linters) {
            ["restic-check"] {
                check {
                    command = "bash hk/restic-check.sh"
                    effect = "read"
                }
            }
            // Vault existence contract (JIN-116): every `pass://` ref in
            // this repo's env files must resolve to a vault/item declared
            // in pkl/Vaults.pkl, and every declared vault/item must
            // actually exist in Proton Pass. Read-only (vault/item
            // listings only, no field values).
            ["vault-inventory"] {
                check {
                    command = "bash hk/capture-vault-inventory.sh && mise exec -- pkl test pkl/Vaults.test.pkl"
                    effect = "read"
                }
            }
            // Capability-acquisition taint tracking (CIT-96): a pass-cli
            // `item view`-shaped acquisition of a synthetic secret must
            // not reach any destination outside its own grant -- an
            // agent's own transcript included. Runs entirely on synthetic
            // data (no live Proton Pass session needed); see
            // hk/capture-taint-trace.sh, hk/check-taint-trace-fail-closed.sh
            // (drives Scope.pkl's fail-closed validation against malformed
            // fixtures as real `pkl eval` subprocesses, since a facts{}
            // entry can't itself catch a thrown Pkl error) and pkl/Scope.pkl.
            ["taint-trace"] {
                check {
                    command = "bash hk/capture-taint-trace.sh && bash hk/check-taint-trace-fail-closed.sh && mise exec -- pkl test pkl/Scope.test.pkl"
                    effect = "read"
                }
            }
            // Syncs pushed commits to the Linear "Development" release.
            // Runs here (not pre-push) since it's a post-push sync, not a
            // push gate -- a stale pass-cli session or a renamed vault
            // should never block `git push`. See hk/linear-release-sync.sh.
            ["linear-release"] {
                check {
                    command = "bash hk/linear-release-sync.sh"
                    effect = "read"
                }
            }
        }
    }
    ["pre-push"] {
        steps {
            // Backs up ~/.claude and ~/.config/container-use to the shared
            // restic repo (disaster recovery only). See
            // hk/claude-session-backup.sh.
            ["claude-session-backup"] {
                check = "bash hk/claude-session-backup.sh"
            }
        }
    }
}
