# Resolved by pass-cli at run time for SUPERVISOR_MODE=calibrate (CIT-472).
# Smaller than supervisor.env: a calibration keeps no transcript, so it needs
# no restic secrets, and its output is a pull request, so it needs a GitHub
# token that can push a branch and open a PR on null-hype/agent-plugins.
CLAUDE_CODE_OAUTH_TOKEN=pass://tidelands.dev/agent/CLAUDE_CODE_OAUTH_TOKEN
LINEAR_API_KEY=pass://api.linear.app/Citizen6.Librarian6.Refrain4/LINEAR_API_KEY
TOOLBOX_TOKEN=pass://infra/render.com/TOOLBOX_TOKEN
# The same reference .devcontainer/gcloud.env uses.
GITHUB_TOKEN=pass://infra/github.com/GITHUB_TOKEN
# Starts the merged changeset's apply on the Render Workflow, and reads how
# the last one went.
RENDER_API_KEY=pass://infra/render.com/RENDER_API_KEY
