# Resolved by pass-cli at run time, same pass:// indirection as
# linear-agent.env and linear-triage-agent.env.
#
# TOOLBOX_TOKEN and PROTON_PASS_PERSONAL_ACCESS_TOKEN are not here -- they
# come from the Render service's own env vars (see README.md).
CLAUDE_CODE_OAUTH_TOKEN=pass://tidelands.dev/agent/CLAUDE_CODE_OAUTH_TOKEN
LINEAR_API_KEY=pass://anthropic.ai/claude/LINEAR_API_KEY
# The restic repo the session transcript lives in; the same references the
# codespace's `color resume` restores from.
GCP_SERVICE_ACCOUNT_KEY=pass://infra/restic/GCP_SERVICE_ACCOUNT_KEY
GOOGLE_PROJECT_ID=pass://infra/restic/GOOGLE_PROJECT_ID
RESTIC_REPOSITORY=pass://infra/restic/RESTIC_REPOSITORY
RESTIC_PASSWORD=pass://infra/restic/RESTIC_PASSWORD
