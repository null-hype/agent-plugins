/// The changeset's schema and cross-references (CIT-472). `problems` is what
/// keeps a bad plan out of a PR: the module refuses to render while it is
/// non-empty, so calibration's `pkl eval` fails on it.
amends "pkl:test"

import "Changeset.pkl"

local valid = (Changeset) {
  seen {
    ["CIT-465"] = "2026-10-21T00:00:00Z"
    ["CIT-500"] = "2026-10-21T00:00:00Z"
    ["CIT-501"] = "2026-10-21T00:00:00Z"
    ["CIT-502"] = "2026-10-21T00:00:00Z"
    ["CIT-503"] = "2026-10-21T00:00:00Z"
    ["CIT-504"] = "2026-10-21T00:00:00Z"
  }
  clusters {
    new {
      key = "new:review-findings"
      title = "Review findings on the supervisor"
      hat = "infra"
      model = "sonnet"
      effort = "high"
      serves = "CIT-439"
      blockedBy { "CIT-465" }
      issues { "CIT-500"; "CIT-501" }
    }
  }
  decline { new { issue = "CIT-502"; reason = "nothing published depends on it" } }
  duplicate { new { issue = "CIT-503"; of = "CIT-500" } }
  escalate { new { issue = "CIT-504"; question = "is this a product decision?" } }
  delegate {
    new { issue = "new:review-findings"; agent = "tidelands-agent" }
    new { issue = "CIT-500"; agent = "tidelands-agent" }
  }
}

local function problemsOf(cs: Changeset): List<String> = cs.problems

facts {
  ["a changeset whose references all resolve has no problems"] {
    valid.problems.isEmpty
  }
  ["an issue placed twice is named with both places"] {
    problemsOf((valid) { decline { new { issue = "CIT-500"; reason = "again" } } })
      == List(
        "CIT-500 is in both cluster new:review-findings and decline",
        // and the delegation of CIT-500 now lands on a declined issue
        "delegate CIT-500 is also in decline"
      )
  }
  ["an issue planning never saw cannot be changed"] {
    problemsOf((valid) { escalate { new { issue = "CIT-999"; question = "why?" } } })
      == List("escalate: CIT-999 was not seen by planning")
  }
  ["a cluster blocked by a new cluster that does not exist is refused"] {
    problemsOf((valid) { clusters { [0] { blockedBy { "new:nothing" } } } })
      == List("cluster new:review-findings: blockedBy new:nothing is neither a cluster nor an issue")
  }
  ["a delegation must land on a cluster or an issue planning saw, and not on a declined one"] {
    problemsOf((valid) {
      delegate {
        new { issue = "CIT-502"; agent = "tidelands-agent" }
        new { issue = "new:nothing"; agent = "tidelands-agent" }
      }
    }) == List(
      "delegate new:nothing is neither a cluster nor an issue planning saw",
      "delegate CIT-502 is also in decline"
    )
  }
  ["a cluster can serve a Release in the changeset's releases"] {
    (valid) {
      releases { new { name = "supervisor-workflow" } }
      clusters { [0] { serves = "release:supervisor-workflow" } }
    }.problems.isEmpty
  }
  ["a Release must be declared to be served, and served to be declared"] {
    problemsOf((valid) {
      releases {
        new { name = "nobody-serves-this" }
        new { name = "nobody-serves-this" }
      }
      clusters { [0] { serves = "release:not-declared" } }
    }) == List(
      "release nobody-serves-this appears twice",
      "cluster new:review-findings: serves release:not-declared, which is not in releases",
      "release nobody-serves-this is served by no cluster"
    )
  }
  ["a cluster key is new:<slug> or an identifier, and its hat, model and effort are closed sets"] {
    for (bad in List("Review Findings", "new:Review", "cit-1")) {
      module.catchOrNull(() -> (Changeset.Cluster) {
        key = bad; title = "t"; hat = "infra"; model = "haiku"; effort = "low"; serves = "CIT-439"; issues { "CIT-500" }
      }.key) != null
    }
    module.catchOrNull(() -> (Changeset.Cluster) {
      key = "new:x"; title = "t"; hat = "planning"; model = "haiku"; effort = "low"; serves = "CIT-439"; issues { "CIT-500" }
    }.hat) != null
    module.catchOrNull(() -> (Changeset.Cluster) {
      key = "new:x"; title = "t"; hat = "infra"; model = "gpt"; effort = "low"; serves = "CIT-439"; issues { "CIT-500" }
    }.model) != null
  }
}
