/// CIT-472: the planning hat's output, a changeset of agentic work.
///
/// Calibration's planning run writes a `changeset.pkl` that amends this
/// module; `pkl eval -f json` renders it to the `changeset.json` the
/// workflow's `apply` task reads. A changeset that does not type-check, or
/// whose references do not resolve, does not render, so it fails the
/// calibration before a PR is opened. Merging the PR is what applies it:
/// Render deploys main, and the deployed `apply` converges Linear to it.
///
/// `src/changeset.ts` mirrors these classes field for field and repeats the
/// cross-reference checks as `validate()`, apply's own guard at run time.
/// Keep the two in sync on drift.
module Changeset

typealias Identifier = String(matches(Regex(#"[A-Z][A-Z0-9]*-[0-9]+"#)))
/// A cluster parent that apply creates. The slug is its stable name across
/// runs: apply finds an earlier one by it rather than creating a second.
typealias NewKey = String(matches(Regex(#"new:[a-z0-9]+(-[a-z0-9]+)*"#)))
typealias Hat = "infra"|"open-source"
typealias Model = "haiku"|"sonnet"|"opus"
typealias Effort = "low"|"medium"|"high"

/// A theme planning found in Triage: a parent issue its members become
/// sub-issues of, which moves them out of Triage, worked by one hat.
class Cluster {
  /// `new:<slug>` creates the parent; an identifier reuses an open issue.
  key: NewKey|Identifier
  title: String(!isBlank)
  description: String = ""
  hat: Hat
  model: Model
  effort: Effort
  /// What the cluster delivers into: its parent, a delivery issue like
  /// CIT-439 until a Release can be attached.
  serves: Identifier
  /// Other clusters (by key) or issues that must finish first.
  blockedBy: Listing<NewKey|Identifier> = new {}
  issues: Listing<Identifier>(!isEmpty)
}

class Decline {
  issue: Identifier
  reason: String(!isBlank)
}

class Duplicate {
  issue: Identifier
  of: Identifier(this != issue)
}

class Escalate {
  issue: Identifier
  question: String(!isBlank)
}

/// Hand an issue, or a cluster by key, to an agent by its Linear name. This
/// replaces asking for the work with an @mention: the delegation is the
/// AgentSessionEvent the self-hosted agent acts on.
class Delegate {
  issue: NewKey|Identifier
  agent: String(!isBlank)
}

/// updatedAt of every existing issue the changeset touches, as planning saw
/// it. apply leaves an issue alone if it has changed since.
seen: Mapping<Identifier, String>
clusters: Listing<Cluster> = new {}
decline: Listing<Decline> = new {}
duplicate: Listing<Duplicate> = new {}
escalate: Listing<Escalate> = new {}
delegate: Listing<Delegate> = new {}

local keys: List<String> = clusters.toList().map((c) -> c.key)
local delegated: List<String> = delegate.toList().map((d) -> d.issue)

/// Where each issue is placed, one entry per placement, in order.
local placements: List<Pair<String, String>> =
  clusters.toList().flatMap((c) -> c.issues.toList().map((i) -> Pair(i, "cluster \(c.key)")))
  + decline.toList().map((d) -> Pair(d.issue, "decline"))
  + duplicate.toList().map((d) -> Pair(d.issue, "duplicate"))
  + escalate.toList().map((e) -> Pair(e.issue, "escalate"))

local function placedIn(issue: String): List<String> =
  placements.filter((p) -> p.first == issue).map((p) -> p.second)

/// Every cross-reference problem, in the order `validate()` reports them.
/// Empty for a changeset that may be applied.
hidden problems: List<String> =
  keys.filter((k) -> keys.count((x) -> x == k) > 1).distinct.map((k) -> "cluster \(k) appears twice")
  + clusters.toList()
      .filter((c) -> !c.key.startsWith("new:") && !seen.containsKey(c.key))
      .map((c) -> "cluster \(c.key): an existing parent must be one planning saw")
  + placements.map((p) -> p.first).distinct
      .filter((i) -> !seen.containsKey(i))
      .map((i) -> "\(placedIn(i).first): \(i) was not seen by planning")
  + placements.map((p) -> p.first).distinct
      .filter((i) -> placedIn(i).length > 1)
      .map((i) -> "\(i) is in both \(placedIn(i)[0]) and \(placedIn(i)[1])")
  + clusters.toList().flatMap((c) -> c.blockedBy.toList()
      .filter((b) -> b.startsWith("new:") && !keys.contains(b))
      .map((b) -> "cluster \(c.key): blockedBy \(b) is neither a cluster nor an issue"))
  + clusters.toList().filter((c) -> c.blockedBy.toList().contains(c.key)).map((c) -> "cluster \(c.key) blocks itself")
  + delegated.filter((i) -> delegated.count((x) -> x == i) > 1).distinct
      .map((i) -> "delegate \(i) appears twice")
  + delegate.toList()
      .filter((d) -> !keys.contains(d.issue) && !seen.containsKey(d.issue))
      .map((d) -> "delegate \(d.issue) is neither a cluster nor an issue planning saw")
  + delegate.toList()
      .filter((d) -> placedIn(d.issue).any((w) -> !w.startsWith("cluster")))
      .map((d) -> "delegate \(d.issue) is also in \(placedIn(d.issue).find((w) -> !w.startsWith("cluster")))")

output {
  value =
    if (problems.isEmpty) module
    else throw("the changeset is invalid:\n- " + problems.join("\n- "))
}
