}

releases {
  new {
    name = "supervisor-workflow"
    description = "The supervisor and its toolbox shipping loop run reliably."
  }
}
clusters {
  new {
    key = "new:ship-destination-identity"
    title = "Ship destination identity and stacked PR ancestry"
    description = "Bounded correction to the session-recovery path (CIT-527): a recovered agent_ship must match the environment and the requested destination branch. The same cluster states the stacked-PR rule: a child issue's PR targets its open parent's branch, targets main once the parent has merged, and fails explicitly when ancestry is missing or ambiguous."
    serves = "release:supervisor-workflow"
    issues { "CIT-527" }
  }
}
ship { new { issue = "CIT-450"; env = "engaged-jawfish" } }