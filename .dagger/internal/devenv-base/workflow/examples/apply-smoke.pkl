// The first real apply (CIT-472): one throwaway Triage issue, CIT-473,
// clustered under a new parent in a test Release. `src/smoke.ts` applies it
// twice against live Linear; the second run must change nothing. Rendered
// with `pkl eval -f json -o examples/apply-smoke.json examples/apply-smoke.pkl`.
amends "../pkl/Changeset.pkl"

// What planning would have seen. smoke.ts replaces it with what Linear says
// now, so a touch since this was written does not read as drift.
seen {
  ["CIT-473"] = "2026-10-21T08:03:29.131Z"
}
releases {
  new {
    name = "supervisor-apply-smoke"
    description = "A test Release for the first real apply of a supervisor changeset (CIT-472). Safe to delete."
  }
}
clusters {
  new {
    key = "new:apply-smoke"
    title = "Apply smoke test: cluster parent (CIT-472)"
    description = "Created by the first real apply of a supervisor changeset. Safe to cancel."
    hat = "infra"
    model = "haiku"
    effort = "low"
    serves = "release:supervisor-apply-smoke"
    issues { "CIT-473" }
  }
}
