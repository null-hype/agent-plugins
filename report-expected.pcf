amends "pkl/Experiment.pkl"

import "pkl/Experiment.pkl"

// CIT-328: two revisions of the document app, each a lesson, each asked the
// same two Questions word for word. `expected` is what a sound authorization
// policy answers: Alice cannot read Bob's private document, and Bob can. An
// answer outside it is the finding, recorded as data.
revisions {
  ["baseline"] {
    subject = "\(lesson.title)?"
    lesson {
      order = 1
      title = "Is the private document private"
      prose = """
        # \(subject)

        The **Client** holds the commit under review, in the form this case gives every
        change: a message whose subject line is a question. Its body is the authorization
        policy the document route runs at this revision. Unfold it to read it.

        Select **Solve** in the top bar to ask the reviewer, Jev. Grey suggested lines
        appear below the commit: the two questions it asks of this revision,
        "\(aliceReads.ask)" and "\(bobReads.ask)". Click the commit, then press **Tab** to
        accept the one shown, or **Alt+]** to switch to the other first. You can take
        either, or both. The **Agent** terminal below prints what Jev was deciding to
        check, and its finding for each question only after you accept it.

        Click the lens above an accepted line to open the evidence behind it: Jev's score
        against the range the Question expects, and the HTTP exchange it judged. A canned
        mock answer is labelled as one; it is not a Jev judgement. The terminal names the
        collected files behind each answer: its `state.json`, and the request and
        response Jev saw.

        Accept both questions before continuing. Alice's HTTP 200 exposes Bob's private
        document; Bob's HTTP 200 establishes the access we must preserve. Signing in
        alone is not enough. In the next lesson, introduce an owner check and repeat
        these same two requests to see whether it fixes the leak without locking Bob out.
        Your accepted lines carry forward in this browser tab, in the order you chose.

        The app is a local synthetic fixture with two signed-in accounts. Solve replays a
        recorded run; it does not run tests or call Jev.
        """
    }
  }
  ["patched"] {
    subject = "\(lesson.title)?"
    lesson {
      order = 2
      title = "Does the owner check keep the document private"
      prose = """
        # \(subject)

        The review goes on from where the first lesson left it: one session, a turn per
        lesson. The baseline commit and the questions you accepted stay above in the
        **Client**, and its findings in the **Agent** terminal. Only the questions you
        actually accepted carry forward; opening this lesson directly does not accept
        the baseline findings for you.

        Alice's baseline request returned Bob's private document. That finding motivates
        the new commit below: replace unconditional access with `document.owner === user`.
        Unfold it to read the previous policy, the proposed check and why it is needed.
        The recorded patch is already applied to the fixture at this turn; **Solve**
        reveals its review.

        The questions are the ones asked of the baseline, word for word. Select **Solve**
        to ask Jev, and take either suggestion with **Tab** (or **Alt+]** to switch first),
        or both. The **Agent** terminal holds back each finding until you accept it.

        Accept both repeated questions. Each finding compares the same request before
        and after the owner check: Alice changes from HTTP 200 to 403, while Bob stays
        at HTTP 200. Open its lens to see the baseline observation beside the patched
        exchange. The patch closes the observed leak and preserves the owner's access.
        These answers cover this one route and these two readers, not every way a
        document can be reached.
        """
    }
  }
}

questions {
  ["baseline-alice-reads"] = (aliceReads) { revision = "baseline" }
  ["baseline-bob-reads"] = (bobReads) { revision = "baseline" }
  // The patch is asked about once the baseline has been: its collector checks
  // it sent the baseline's request again.
  ["patched-alice-reads"] = (aliceReads) {
    revision = "patched"
    dependencies { "baseline-alice-reads" }
    requiredEvidence { "prerequisites" }
  }
  ["patched-bob-reads"] = (bobReads) {
    revision = "patched"
    dependencies { "baseline-bob-reads" }
    requiredEvidence { "prerequisites" }
  }
}

local aliceReads: Experiment.Asked = new {
  ask = "Can Alice read Bob's private document?"
  judge {
    type = "noul"
    instructions = "\(ask) Alice is signed in; the document belongs to Bob. Judge only the supplied HTTP observation, authorization policy and fixture state."
    criteria {
      `true` = "The response to Alice contains Bob's private document, and fixture state identifies Bob as its owner."
      `false` = "The request is denied, ownership or caller identity is unestablished, or no private content is returned."
    }
  }
  collector = "read-as-alice"
  requiredEvidence { "http"; "fixtureState"; "authorizationPolicy" }
  expected { min = 0; max = 0.2 }
}

local bobReads: Experiment.Asked = new {
  ask = "Can Bob read it?"
  judge {
    type = "noul"
    instructions = "Can Bob read his own private document? Bob is signed in and owns it. Judge only the supplied HTTP observation, authorization policy and fixture state."
    criteria {
      `true` = "The response to Bob contains his private document, and fixture state identifies Bob as its owner."
      `false` = "The request is denied, ownership or caller identity is unestablished, or other content is returned."
    }
  }
  collector = "read-as-bob"
  requiredEvidence { "http"; "fixtureState"; "authorizationPolicy" }
  expected { min = 0.8; max = 1 }
}
