/// Reconcile.pkl against what witness showed on the check's first passing run
/// (feature e4363c2a29e3, after one repair), and against that run with one
/// steady step warmed, an answer stale, the predictions registered before
/// Jules planned, or changed after its plan was approved. No I/O.
amends "pkl:test"

import "Reconcile.pkl"
import "Predicted.pkl"

// Jules is asked at 10:01, the plan approved at 10:20 in the work run, after
// which the work run's repair session is created.
local function shown(defn: Float, script: Float, precommit: Float, submit: Float) = new Dynamic {
  created { "2026-10-27T10:01:00.000Z" }
  approved {}
  model = "jev-1.14.0"
  shown {
    ["Create the dev container feature definition"] = defn
    ["Create the installation script"] = script
    ["Complete pre-commit steps"] = precommit
    ["Submit the change"] = submit
  }
  offLine {}
  stale {}
}

local function registered(at: String) = (Predicted) {
  registered = new Dynamic {
    item = "jev-planner/journal"
    role = "Viewer"
    written = at
    plan {
      new { title = "Create the dev container feature definition"; after = "cools" }
      new { title = "Create the installation script"; after = "cools" }
      new { title = "Complete pre-commit steps"; after = "steady" }
      new { title = "Submit the change"; after = "steady" }
    }
  }
}

local function worked(defn: Float, script: Float, precommit: Float, submit: Float) =
  (shown(defn, script, precommit, submit)) {
    created { "2026-10-27T10:30:00.000Z" }
    approved { "2026-10-27T10:20:00.000Z" }
  }

local between = registered("2026-10-27T10:10:00.000Z")

local passed = (Reconcile) {
  predicted = between
  observed = new Dynamic {
    plan = shown(0.59, 0.58, 0.52, 0.52)
    work = worked(0.33, 0.27, 0.49, 0.48)
  }
}

local warmed = (passed) {
  observed = new Dynamic {
    plan = shown(0.59, 0.58, 0.52, 0.52)
    work = worked(0.33, 0.27, 0.49, 0.70)
  }
}

local stale = (passed) {
  observed = new Dynamic {
    plan = shown(0.59, 0.58, 0.52, 0.52)
    work = (worked(0.33, 0.27, 0.49, 0.48)) { stale { "stale finding (verified against other source): 0.48 still a priority: Submit the change" } }
  }
}

local beforePlan = (passed) { predicted = registered("2026-10-27T09:00:00.000Z") }

local afterApproval = (passed) { predicted = registered("2026-10-27T10:25:00.000Z") }

facts {
  ["the first passing run passes"] { passed.pass; passed.installedPass }
  ["a steady step that warms fails the experiment, not the install"] {
    !warmed.pass; warmed.installedPass; !warmed.facts["the work left steady Submit the change"]
  }
  ["predictions registered before Jules was asked for the plan fail"] {
    !beforePlan.pass; !beforePlan.facts["the predictions were last changed after Jules was asked for the plan"]
  }
  ["predictions changed after the plan was approved fail"] {
    !afterApproval.pass; !afterApproval.facts["the predictions were last changed before Jules's plan was approved"]
  }
  ["a stale answer fails both"] { !stale.pass; !stale.installedPass }
}

examples {
  ["the first passing run, fact by fact"] { passed.facts; passed.next }
}
