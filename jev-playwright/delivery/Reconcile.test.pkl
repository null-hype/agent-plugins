/// Reconcile.pkl against what witness showed on the check's first passing run
/// (feature e4363c2a29e3, after one repair), and against that run with one
/// steady step warmed, an answer stale, the predictions registered before
/// Jules planned, or changed after its plan was approved; and against run 7,
/// the counterexample. No I/O.
amends "pkl:test"

import "Reconcile.pkl"
import "Predicted.pkl"
import "worlds/Scenarios.pkl"

// Jules is asked at 10:01, the plan approved at 10:20 in the work run, after
// which the work run's repair session is created. The scores and times are
// worlds/Scenarios.pkl's, which worlds/mk.mjs also builds the fixtures from.
local function plan(s: Scenarios.Scenario) = new Dynamic {
  created { s.planCreated }
  approved {}
  model = "jev-1.14.0"
  shown {
    for (step in s.steps) { [step.title] = step.plan }
  }
  offLine {}
  stale {}
}

local function work(s: Scenarios.Scenario) = (plan(s)) {
  created { s.workCreated }
  approved { s.approved }
  shown {
    for (step in s.steps) { [step.title] = step.work }
  }
}

local function registered(s: Scenarios.Scenario, at: String) = (Predicted) {
  registered = new Dynamic {
    item = "jev-planner/journal"
    role = "Viewer"
    written = at
    plan {
      for (step in s.steps) { new { title = step.title; after = step.after } }
    }
  }
}

local fp = Scenarios.firstPassing

local between = registered(fp, fp.written)

local passed = (Reconcile) {
  predicted = between
  observed = new Dynamic {
    plan = plan(fp)
    work = work(fp)
  }
}

local warmed = (passed) {
  observed = new Dynamic {
    plan = plan(fp)
    work = (work(fp)) { shown { ["Submit the change"] = 0.70 } }
  }
}

local stale = (passed) {
  observed = new Dynamic {
    plan = plan(fp)
    work = (work(fp)) { stale { "stale finding (verified against other source): 0.48 still a priority: Submit the change" } }
  }
}

local beforePlan = (passed) { predicted = registered(fp, "2026-10-27T09:00:00.000Z") }

local afterApproval = (passed) { predicted = registered(fp, "2026-10-27T10:25:00.000Z") }

// Run 7 (2026-10-27): registered at 07:52:52 for the plan Jules was asked for
// at 07:47:34. The first feature failed (Go was not installed); repair 1
// installed witness. The scores are as the check printed them, to the
// hundredth (the plan's from the work's less the printed movement); the
// approval and repair times were not kept, so they stand in, after the
// registration. Its world and protocol held; the two file steps did not cool,
// though the feature that installed was the work, and the first, broken work
// had cooled them (0.22, 0.19). The times test the order the protocol
// needs, not the run's whole record.
//
// It is a frozen falsification case: a change that turns it green changes
// what a Jev step score means, and has to say how, not pass as a fix.
local run7 = (Reconcile) {
  predicted = registered(Scenarios.run7, Scenarios.run7.written)
  observed = new Dynamic {
    plan = plan(Scenarios.run7)
    work = work(Scenarios.run7)
  }
}

facts {
  ["run 7 is a valid finding: Jev disagreement"] {
    run7.installedPass; run7.protocolPass; run7.valid; !run7.measuredPass; !run7.pass
    !run7.measured["the work cooled Create `src/witness/devcontainer-feature.json`."]
    !run7.measured["the work cooled Create `src/witness/install.sh`."]
    run7.verdict.startsWith("valid finding: Jev disagreement")
  }
  ["the first passing run is valid, and Jev agreed"] { passed.valid; passed.pass }
  ["a steady step that warms is a valid disagreement"] {
    warmed.valid; !warmed.pass; !warmed.facts["the work left steady Submit the change"]
  }
  ["predictions registered before Jules was asked for the plan are not valid"] {
    !beforePlan.valid; !beforePlan.protocolPass; !beforePlan.facts["the predictions were last changed after Jules was asked for the plan"]
  }
  ["predictions changed after the plan was approved are not valid"] {
    !afterApproval.valid; !afterApproval.facts["the predictions were last changed before Jules's plan was approved"]
  }
  ["a stale answer is not valid"] { !stale.valid; !stale.installedPass }
}

examples {
  ["the first passing run, fact by fact"] { passed.facts; passed.next }
  ["run 7, layer by layer"] { run7.installed; run7.protocol; run7.measured; run7.movements; run7.verdict }
}
