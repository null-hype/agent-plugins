/// CIT-286 deterministic contract scenario: reasoning model -> Jev.
///
/// Generic "stated never / enforced" evidence and generic Noul questions; no
/// CVE or case data. The two observations are a matched pair (same shape, the
/// enforcement answer differs), so the relative expectation has something to
/// discriminate. The mock answers below only wire that pair through; they are
/// NOT a measurement of Jev.
amends "modulepath:/Scenario.pkl"

groundingFiles {
  ["app/README.md"] = "Never pass untrusted input to run.sh.\n"
  ["app/guard.md"] = "run.sh rejects untrusted input before use.\n"
}

observations {
  ["arm_unenforced"] {
    findings {
      new {
        component = "run.sh"
        source_path = "app/README.md"
        excerpt = "Never pass untrusted input"
        never = "passing untrusted input to run.sh"
        enforced = false
      }
    }
  }
  ["arm_enforced"] {
    findings {
      new {
        component = "run.sh"
        source_path = "app/guard.md"
        excerpt = "rejects untrusted input before use"
        never = "passing untrusted input to run.sh"
        enforced = true
      }
    }
  }
  ["no_findings"] {
    findings {}
  }
}

ungrounded {
  ["excerpt_not_in_file"] {
    findings {
      new {
        component = "run.sh"
        source_path = "app/README.md"
        excerpt = "Always pass untrusted input"
        never = "passing untrusted input to run.sh"
        enforced = false
      }
    }
  }
  ["file_not_in_root"] {
    findings {
      new {
        component = "run.sh"
        source_path = "app/missing.md"
        excerpt = "x"
        never = "passing untrusted input to run.sh"
        enforced = false
      }
    }
  }
}

malformed {
  ["missing_keys"] = #"{"findings":[{"component":"run.sh"}]}"#
  ["extra_key"] = #"{"findings":[],"answer":0.9}"#
  ["not_json"] = "not json"
}

questions {
  ["unenforced_never"] {
    type = "noul"
    instructions = "A component states a rule that must never be violated. Does the composed system fail to enforce it (an unenforced never)?"
  }
}

// Mock stimulus only (see header).
mockAnswers {
  ["arm_unenforced"] { ["unenforced_never"] = 0.83 }
  ["arm_enforced"] { ["unenforced_never"] = 0.12 }
  ["no_findings"] { ["unenforced_never"] = 0.05 }
}

expectations {
  relative {
    new { question = "unenforced_never"; higher = "arm_unenforced"; lower = "arm_enforced" }
    new { question = "unenforced_never"; higher = "arm_unenforced"; lower = "no_findings" }
  }
  // Uncalibrated: exercises the band executor against mock answers only.
  // Not a claim about where Jev's confidence should fall.
  bands {
    new { question = "unenforced_never"; observation = "arm_unenforced"; min = 0.5; max = 1.0 }
    new { question = "unenforced_never"; observation = "arm_enforced"; min = 0.0; max = 0.5 }
  }
}

// Known-input worlds for the verdict functions: each names the verdict every
// check must produce. An expected diagnostic legitimately "passes" -- these
// assert that a divergence is correctly REPORTED, not that everything is fine.
diagnostics {
  ["aligned"] {
    world = new { run = "diag"; repeat = 0; real = false; worldRef = "diag:aligned"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 0.83 }
        ["arm_enforced"] { ["unenforced_never"] = 0.12 }
        ["no_findings"] { ["unenforced_never"] = 0.05 }
      }
    }
    expect {
      ["validity:arm_unenforced:unenforced_never"] = "VALID_PROBABILITY"
      ["relative:unenforced_never:arm_unenforced>arm_enforced"] = "EXPECTED_ORDER"
      ["relative:unenforced_never:arm_unenforced>no_findings"] = "EXPECTED_ORDER"
      ["band:unenforced_never:arm_unenforced"] = "WITHIN_BAND"
      ["band:unenforced_never:arm_enforced"] = "WITHIN_BAND"
    }
  }
  ["out_of_band"] {
    world = new { run = "diag"; repeat = 0; real = false; worldRef = "diag:out_of_band"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 0.3 }
        ["arm_enforced"] { ["unenforced_never"] = 0.12 }
        ["no_findings"] { ["unenforced_never"] = 0.05 }
      }
    }
    expect {
      ["relative:unenforced_never:arm_unenforced>arm_enforced"] = "EXPECTED_ORDER"
      ["band:unenforced_never:arm_unenforced"] = "OUTSIDE_BAND"
      ["band:unenforced_never:arm_enforced"] = "WITHIN_BAND"
    }
  }
  ["order_reversed"] {
    world = new { run = "diag"; repeat = 0; real = false; worldRef = "diag:order_reversed"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 0.2 }
        ["arm_enforced"] { ["unenforced_never"] = 0.6 }
        ["no_findings"] { ["unenforced_never"] = 0.2 }
      }
    }
    expect {
      ["relative:unenforced_never:arm_unenforced>arm_enforced"] = "ORDER_REVERSED"
      ["relative:unenforced_never:arm_unenforced>no_findings"] = "ORDER_TIED"
    }
  }
  ["invalid_probability"] {
    world = new { run = "diag"; repeat = 0; real = false; worldRef = "diag:invalid_probability"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 1.5 }
        ["arm_enforced"] { ["unenforced_never"] = 0.12 }
        ["no_findings"] { ["unenforced_never"] = 0.05 }
      }
    }
    expect { ["validity:arm_unenforced:unenforced_never"] = "INVALID_PROBABILITY" }
  }
  ["missing_observation"] {
    world = new { run = "diag"; repeat = 0; real = false; worldRef = "diag:missing_observation"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 0.83 }
      }
    }
    expect {
      ["relative:unenforced_never:arm_unenforced>arm_enforced"] = "MISSING_OBSERVATION"
      ["band:unenforced_never:arm_enforced"] = "MISSING_OBSERVATION"
    }
  }
  ["uncalibrated_real"] {
    world = new { run = "diag"; repeat = 0; real = true; worldRef = "diag:uncalibrated_real"
      results {
        ["arm_unenforced"] { ["unenforced_never"] = 0.83 }
        ["arm_enforced"] { ["unenforced_never"] = 0.12 }
        ["no_findings"] { ["unenforced_never"] = 0.05 }
      }
    }
    expect {
      ["band:unenforced_never:arm_unenforced"] = "NOT_ASSERTED_UNCALIBRATED"
      ["band:unenforced_never:arm_enforced"] = "NOT_ASSERTED_UNCALIBRATED"
      ["relative:unenforced_never:arm_unenforced>arm_enforced"] = "EXPECTED_ORDER"
    }
  }
}
