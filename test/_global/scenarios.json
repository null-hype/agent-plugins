{
    "color_and_playwright_cli": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "pass-cli": {
                "favorite": "purple"
            },
            "playwright-cli": {
                "browser": "firefox"
            }
        }
    },
    "jin-81-pass-cli": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {
                "favorite": "green",
                "tag": "jin-81-pass-cli"
            },
            "playwright-cli": {}
        },
        "remoteEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    },
    "jin-90-dead-drop": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {}
        },
        "remoteEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    },
    "cit-96-taint-trace": {
        "build": {
            "dockerfile": "cit-96-taint-trace/Dockerfile",
            "context": "../.."
        },
        "features": {
            "pass-cli": {
                "tag": "cit-96-taint-trace"
            }
        },
        "remoteEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    },
    "jin-91-resume-session": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {
                "tag": "jin-91-resume-session"
            }
        },
        "remoteEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    }
}
