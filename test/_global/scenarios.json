{
    "cit-286-contract": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "evidence": {},
            "jev": {}
        }
    },
    "cit-286-toy-smoke": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "evidence": {},
            "jev": {},
            "pass-cli": {
                "tag": "cit-286-toy-smoke"
            }
        },
        "containerEnv": {
            "CONTRACT_MODE": "${localEnv:CONTRACT_MODE:deterministic}",
            "CONTRACT_ALLOW_REAL_JEV": "${localEnv:CONTRACT_ALLOW_REAL_JEV:0}",
            "CONTRACT_ALLOW_REASONING_AGENT": "${localEnv:CONTRACT_ALLOW_REASONING_AGENT:0}",
            "CONTRACT_REPEATS": "${localEnv:CONTRACT_REPEATS:1}",
            "CONTRACT_MODEL": "${localEnv:CONTRACT_MODEL:}",
            "CONTRACT_MAX_TOKENS": "${localEnv:CONTRACT_MAX_TOKENS:}",
            "CONTRACT_MAX_USD": "${localEnv:CONTRACT_MAX_USD:}",
            "REASONING_AGENT_RUNNER": "${localEnv:REASONING_AGENT_RUNNER:}",
            "TYPESAFE_API_KEY": "${localEnv:TYPESAFE_API_KEY:}",
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN:}"
        }
    },
    "color_and_playwright_cli": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "pass-cli": {
                "favorite": "purple"
            },
            "playwright-cli": {
                "browser": "firefox"
            }
        }
    },
    "jin-81-pass-cli": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {
                "favorite": "green",
                "tag": "jin-81-pass-cli"
            },
            "playwright-cli": {}
        },
        "containerEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    },
    "jin-90-dead-drop": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {}
        },
        "containerEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    },
    "jin-91-resume-session": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "pass-cli": {
                "tag": "jin-91-resume-session"
            }
        },
        "containerEnv": {
            "PROTON_PASS_PERSONAL_ACCESS_TOKEN": "${localEnv:PROTON_PASS_PERSONAL_ACCESS_TOKEN}"
        }
    }
